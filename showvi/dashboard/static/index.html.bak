<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Video Director — Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&family=Noto+Sans+SC:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --bg-primary: #08090d;
  --bg-secondary: #0f1117;
  --bg-card: rgba(17, 19, 28, 0.75);
  --bg-card-hover: rgba(25, 28, 42, 0.85);
  --bg-glass: rgba(255, 255, 255, 0.03);
  --border-subtle: rgba(255, 255, 255, 0.06);
  --border-accent: rgba(99, 102, 241, 0.3);
  --text-primary: #e8eaed;
  --text-secondary: #9aa0ab;
  --text-muted: #5a6172;
  --accent: #6366f1;
  --accent-glow: rgba(99, 102, 241, 0.15);
  --accent-2: #8b5cf6;
  --success: #10b981;
  --success-glow: rgba(16, 185, 129, 0.15);
  --warning: #f59e0b;
  --warning-glow: rgba(245, 158, 11, 0.12);
  --error: #ef4444;
  --error-glow: rgba(239, 68, 68, 0.12);
  --cyan: #06b6d4;
  --pink: #ec4899;
  --radius: 12px;
  --radius-lg: 16px;
  --radius-xl: 20px;
  --shadow-lg: 0 8px 32px rgba(0,0,0,0.4);
  --font-sans: 'Inter', 'Noto Sans SC', -apple-system, sans-serif;
  --font-mono: 'JetBrains Mono', monospace;
  --transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

html { font-size: 14px; }
body {
  font-family: var(--font-sans);
  background: var(--bg-primary);
  color: var(--text-primary);
  min-height: 100vh;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

.bg-mesh {
  position: fixed; inset: 0; z-index: 0; pointer-events: none;
  background:
    radial-gradient(ellipse 800px 600px at 15% 20%, rgba(99,102,241,0.08) 0%, transparent 60%),
    radial-gradient(ellipse 600px 500px at 85% 75%, rgba(139,92,246,0.06) 0%, transparent 60%),
    radial-gradient(ellipse 500px 400px at 50% 50%, rgba(6,182,212,0.04) 0%, transparent 60%);
  animation: meshDrift 20s ease-in-out infinite alternate;
}
@keyframes meshDrift { 0% { transform: translate(0,0) scale(1); } 100% { transform: translate(-20px,15px) scale(1.03); } }
@keyframes spin { to { transform: rotate(360deg); } }

.app { position: relative; z-index: 1; display: flex; flex-direction: row; min-height: 100vh; }

/* ── Left Navigation Rail ────────────────────────────────────── */
.nav-rail {
  width: 68px; min-width: 68px; height: 100vh;
  background: rgba(8,9,13,0.95);
  backdrop-filter: blur(20px) saturate(1.5);
  border-right: 1px solid var(--border-subtle);
  display: flex; flex-direction: column; align-items: center;
  padding: 12px 0; gap: 4px;
  position: sticky; top: 0; z-index: 100;
}
.nav-logo {
  width: 38px; height: 38px; border-radius: 10px;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  display: flex; align-items: center; justify-content: center;
  font-weight: 800; font-size: 18px; color: #fff;
  box-shadow: 0 0 20px var(--accent-glow);
  margin-bottom: 16px; flex-shrink: 0;
}
.nav-btn {
  width: 52px; height: 52px; border-radius: 12px; border: none;
  background: transparent; color: var(--text-muted);
  cursor: pointer; transition: var(--transition);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 3px; font-family: var(--font-sans); font-size: 9px; font-weight: 600;
  letter-spacing: 0.3px;
}
.nav-btn svg { width: 20px; height: 20px; flex-shrink: 0; }
.nav-btn:hover { color: var(--text-secondary); background: rgba(255,255,255,0.04); }
.nav-btn.active { color: var(--accent); background: rgba(99,102,241,0.12); }
.nav-spacer { flex: 1; }
.nav-indicator {
  display: none; align-items: center; gap: 4px;
  font-size: 9px; color: var(--success); font-weight: 600;
  flex-direction: column;
}
.nav-indicator.show { display: flex; }

/* ── Tutorial Button & Modal ── */
.nav-tutorial-stack {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  width: 100%;
}
.nav-tutorial-btn {
  width: 52px; height: 52px; border-radius: 12px; border: none;
  background: transparent; color: var(--text-muted);
  cursor: pointer; transition: var(--transition);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 3px; font-family: var(--font-sans); font-size: 9px; font-weight: 600;
  letter-spacing: 0.3px;
}
.nav-tutorial-btn svg { width: 20px; height: 20px; flex-shrink: 0; }
.nav-tutorial-btn:hover { color: var(--accent); background: rgba(99,102,241,0.12); }

.nav-credits-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 12px;
  font-weight: 700;
  color: var(--accent);
  background: rgba(99,102,241,0.12);
  border-radius: 10px;
  padding: 6px 10px;
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.15s;
}
.nav-credits-badge:hover { background: rgba(99,102,241,0.22); }

.nav-user-btn {
  width: 52px;
  min-height: 52px;
  border-radius: 12px;
  border: 1px solid transparent;
  background: transparent;
  color: var(--text-muted);
  cursor: pointer;
  transition: var(--transition);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4px;
  font-family: var(--font-sans);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.3px;
  padding: 6px 4px;
}
.nav-user-btn:hover {
  color: var(--text-primary);
  background: rgba(255,255,255,0.04);
  border-color: rgba(255,255,255,0.08);
}
.nav-user-avatar {
  width: 24px;
  height: 24px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 800;
  color: #fff;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  box-shadow: 0 0 16px rgba(99,102,241,0.18);
}
.nav-user-label {
  max-width: 44px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-menu-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 10020;
  background: rgba(0,0,0,0.58);
  backdrop-filter: blur(8px);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 24px;
}
.user-menu-modal-backdrop.show { display: flex; }
.user-menu-modal-backdrop.proxy-child-open {
  pointer-events: none;
}
.user-menu-modal-backdrop.proxy-child-open .user-menu-modal {
  opacity: 0.42;
  transform: scale(0.985);
  filter: saturate(0.85);
}
.user-menu-modal {
  width: min(920px, 100%);
  max-height: min(86vh, 920px);
  overflow: auto;
  border-radius: 20px;
  border: 1px solid var(--border-subtle);
  background: rgba(12, 13, 20, 0.96);
  box-shadow: 0 32px 90px rgba(0,0,0,0.55);
  padding: 24px;
}
.user-menu-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 18px;
}
.user-menu-title {
  display: flex;
  align-items: center;
  gap: 14px;
}
.user-menu-avatar {
  width: 52px;
  height: 52px;
  border-radius: 16px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  font-weight: 800;
  color: #fff;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
}
.user-menu-header h3 {
  margin: 0;
  font-size: 22px;
}
.user-menu-subtitle {
  margin-top: 4px;
  color: var(--text-muted);
  font-size: 13px;
  line-height: 1.6;
}
.user-menu-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}
.user-menu-card {
  border-radius: 16px;
  border: 1px solid var(--border-subtle);
  background: rgba(255,255,255,0.03);
  padding: 16px;
}
.user-menu-card h4 {
  margin: 0 0 12px;
  font-size: 14px;
}
.user-menu-meta {
  display: grid;
  gap: 10px;
}
.user-menu-meta-row {
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.user-menu-meta-row span {
  color: var(--text-muted);
  font-size: 12px;
}
.user-menu-meta-row strong {
  color: var(--text-primary);
  word-break: break-all;
  font-size: 13px;
}
.user-menu-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}
.user-menu-actions button,
.admin-user-actions button,
.admin-create-form button {
  border: 1px solid var(--border-subtle);
  background: rgba(255,255,255,0.05);
  color: var(--text-primary);
  border-radius: 10px;
  padding: 9px 12px;
  font: inherit;
  cursor: pointer;
}
.user-menu-actions button:hover,
.admin-user-actions button:hover,
.admin-create-form button:hover {
  background: rgba(255,255,255,0.09);
}
.user-menu-actions .danger-btn,
.admin-user-actions .danger-btn {
  border-color: rgba(239,68,68,0.22);
  color: #fca5a5;
}
.admin-panel {
  margin-top: 18px;
  border-radius: 18px;
  border: 1px solid var(--border-subtle);
  background: rgba(255,255,255,0.025);
  padding: 18px;
}
.admin-panel.hidden { display: none; }
.admin-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 14px;
}
.admin-panel-title {
  margin: 0;
  font-size: 15px;
}
.admin-panel-note {
  color: var(--text-muted);
  font-size: 12px;
  line-height: 1.6;
}
.admin-create-form {
  display: grid;
  grid-template-columns: 1.2fr 1fr 0.7fr auto;
  gap: 10px;
  margin-bottom: 16px;
}
.admin-create-form input,
.admin-create-form select {
  width: 100%;
  border-radius: 12px;
  border: 1px solid var(--border-subtle);
  background: rgba(255,255,255,0.04);
  color: var(--text-primary);
  padding: 11px 12px;
  font: inherit;
}
.admin-users-list {
  display: grid;
  gap: 10px;
}
.admin-user-row {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.7fr) minmax(0, 0.85fr) auto;
  gap: 12px;
  align-items: center;
  padding: 14px;
  border-radius: 14px;
  background: rgba(255,255,255,0.035);
  border: 1px solid rgba(255,255,255,0.05);
}
.admin-user-main {
  min-width: 0;
}
.admin-user-name {
  font-weight: 700;
  font-size: 14px;
}
.admin-user-path {
  margin-top: 4px;
  color: var(--text-muted);
  font-size: 12px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.admin-user-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  border-radius: 999px;
  width: fit-content;
  font-size: 12px;
  font-weight: 700;
  background: rgba(99,102,241,0.14);
  color: #c7d2fe;
}
.admin-user-badge.inactive {
  background: rgba(239,68,68,0.12);
  color: #fca5a5;
}
.admin-user-role {
  color: var(--text-secondary);
  font-size: 13px;
}
.admin-user-actions {
  display: flex;
  gap: 8px;
  justify-content: flex-end;
  flex-wrap: wrap;
}
.user-menu-status {
  margin-top: 12px;
  min-height: 20px;
  color: var(--text-muted);
  font-size: 12px;
}
.hidden { display: none !important; }
.credits-balance-row {
  display: flex;
  align-items: baseline;
  gap: 10px;
  margin-bottom: 14px;
}
.credits-balance-value {
  font-size: 28px;
  font-weight: 700;
  color: var(--accent);
  line-height: 1;
}
.credits-balance-label {
  color: var(--text-muted);
  font-size: 13px;
}
.credits-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  align-items: center;
}
.credits-actions input {
  flex: 1;
  min-width: 140px;
  border-radius: 12px;
  border: 1px solid var(--border-subtle);
  background: rgba(255,255,255,0.04);
  color: var(--text-primary);
  padding: 9px 12px;
  font: inherit;
  font-size: 13px;
}
.credits-actions button {
  border: 1px solid var(--border-subtle);
  background: rgba(255,255,255,0.05);
  color: var(--text-primary);
  border-radius: 10px;
  padding: 9px 14px;
  font: inherit;
  font-size: 13px;
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.15s;
}
.credits-actions button:hover {
  background: rgba(255,255,255,0.09);
}
.credits-status {
  margin-top: 8px;
  font-size: 12px;
  color: var(--text-muted);
  line-height: 1.6;
}
.credits-history-panel {
  margin-top: 14px;
  max-height: 260px;
  overflow: auto;
  font-size: 12px;
}
.credits-history-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 0;
  border-bottom: 1px solid rgba(255,255,255,0.04);
  gap: 8px;
}
.credits-history-row:last-child { border-bottom: none; }
.credits-history-time {
  color: var(--text-muted);
  font-size: 11px;
  white-space: nowrap;
}
.credits-history-label { margin-left: 6px; }
.credits-history-amount {
  font-weight: 600;
  white-space: nowrap;
}
.credits-history-amount.positive { color: var(--success, #22c55e); }
.credits-history-amount.negative { color: var(--error, #ef4444); }
.credits-history-balance {
  color: var(--text-muted);
  font-weight: 400;
  font-size: 11px;
  margin-left: 4px;
}
.credits-more-btn {
  border: 1px solid var(--border-subtle);
  background: rgba(255,255,255,0.05);
  color: var(--text-muted);
  border-radius: 8px;
  padding: 5px 16px;
  font: inherit;
  font-size: 11px;
  cursor: pointer;
  transition: background 0.15s;
}
.credits-more-btn:hover { background: rgba(255,255,255,0.09); }
.admin-section-divider {
  margin-top: 20px;
  border-top: 1px solid var(--border-subtle);
  padding-top: 16px;
}
.admin-section-divider h4 {
  margin: 0 0 12px;
  font-size: 14px;
}
.admin-credits-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 12px;
}
.admin-credits-table th {
  color: var(--text-muted);
  text-align: left;
  padding: 6px 8px;
  font-weight: 500;
  border-bottom: 1px solid var(--border-subtle);
}
.admin-credits-table td {
  padding: 6px 8px;
  border-bottom: 1px solid rgba(255,255,255,0.04);
}
.admin-credits-table tr:last-child td { border-bottom: none; }
.admin-credits-table .code-cell {
  font-family: 'SF Mono', 'Fira Code', monospace;
  cursor: pointer;
  transition: color 0.15s;
}
.admin-credits-table .code-cell:hover { color: var(--accent); }

.tutorial-modal-backdrop {
  position: fixed; inset: 0; z-index: 9999;
  background: rgba(0,0,0,0.6); backdrop-filter: blur(6px);
  display: none; align-items: center; justify-content: center;
}
.tutorial-modal-backdrop.show { display: flex; }
.tutorial-modal {
  background: var(--surface-2, #16181f);
  border: 1px solid var(--border-subtle, rgba(255,255,255,0.08));
  border-radius: 20px;
  padding: 32px 28px 28px;
  width: 680px; max-width: 95vw;
  box-shadow: 0 24px 80px rgba(0,0,0,0.6);
  position: relative;
}
.tutorial-modal.credit-rule {
  width: 760px;
}
.tutorial-modal-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 24px;
}
.tutorial-modal-title {
  font-size: 18px; font-weight: 700; color: var(--text-primary, #fff);
  display: flex; align-items: center; gap: 10px;
}
.tutorial-modal-title svg { color: var(--accent, #6366f1); }
.tutorial-close-btn {
  width: 32px; height: 32px; border-radius: 8px; border: none;
  background: rgba(255,255,255,0.06); color: var(--text-muted);
  cursor: pointer; display: flex; align-items: center; justify-content: center;
  transition: var(--transition);
}
.tutorial-close-btn:hover { background: rgba(255,255,255,0.12); color: var(--text-primary); }
.tutorial-cards {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
}
.tutorial-card {
  background: rgba(255,255,255,0.03);
  border: 1px solid rgba(255,255,255,0.07);
  border-radius: 14px; padding: 20px 16px 18px;
  display: flex; flex-direction: column; gap: 12px;
  transition: border-color 0.2s, background 0.2s;
}
.tutorial-card:hover {
  border-color: rgba(99,102,241,0.35);
  background: rgba(99,102,241,0.06);
}
.tutorial-card-icon {
  width: 44px; height: 44px; border-radius: 12px;
  display: flex; align-items: center; justify-content: center;
  font-size: 22px; flex-shrink: 0;
}
.tutorial-card-icon.novel  { background: rgba(99,102,241,0.15); }
.tutorial-card-icon.video  { background: rgba(236,72,153,0.15); }
.tutorial-card-icon.create { background: rgba(16,185,129,0.15); }
.tutorial-card-icon.credit { background: rgba(250,204,21,0.16); }
.tutorial-card-icon.redeem { background: rgba(6,182,212,0.16); }
.tutorial-card-icon.proxy { background: rgba(168,85,247,0.16); }
.tutorial-card-title {
  font-size: 14px; font-weight: 700; color: var(--text-primary, #fff);
}
.tutorial-card-badge {
  display: inline-block; font-size: 10px; font-weight: 600;
  padding: 2px 8px; border-radius: 20px; margin-bottom: 2px;
}
.tutorial-card-badge.novel  { background: rgba(99,102,241,0.2); color: #818cf8; }
.tutorial-card-badge.video  { background: rgba(236,72,153,0.2); color: #f472b6; }
.tutorial-card-badge.create { background: rgba(16,185,129,0.2); color: #34d399; }
.tutorial-card-badge.credit { background: rgba(250,204,21,0.2); color: #fde68a; }
.tutorial-card-badge.redeem { background: rgba(6,182,212,0.2); color: #67e8f9; }
.tutorial-card-badge.proxy  { background: rgba(168,85,247,0.2); color: #d8b4fe; }
.tutorial-card-desc {
  font-size: 12px; color: var(--text-muted, #888); line-height: 1.7;
}
.tutorial-card-step {
  display: flex; align-items: flex-start; gap: 8px;
  font-size: 12px; color: var(--text-secondary, #aaa); line-height: 1.6;
}
.tutorial-card-step-num {
  width: 18px; height: 18px; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 10px; font-weight: 700; margin-top: 1px;
}
.tutorial-card-step-num.novel  { background: rgba(99,102,241,0.25); color: #818cf8; }
.tutorial-card-step-num.video  { background: rgba(236,72,153,0.25); color: #f472b6; }
.tutorial-card-step-num.create { background: rgba(16,185,129,0.25); color: #34d399; }
.tutorial-card-step-num.credit { background: rgba(250,204,21,0.25); color: #fde68a; }
.tutorial-card-step-num.redeem { background: rgba(6,182,212,0.25); color: #67e8f9; }
.tutorial-card-step-num.proxy  { background: rgba(168,85,247,0.25); color: #d8b4fe; }
.tutorial-footer {
  margin-top: 20px; text-align: center;
  font-size: 11px; color: var(--text-muted, #666);
}

@media (max-width: 960px) {
  .user-menu-grid,
  .admin-create-form,
  .admin-user-row {
    grid-template-columns: 1fr;
  }
  .admin-user-actions {
    justify-content: flex-start;
  }
}

.live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--success); box-shadow: 0 0 8px var(--success); animation: pulse 2s ease-in-out infinite; }
@keyframes pulse { 0%,100% { opacity:1; transform:scale(1); } 50% { opacity:0.5; transform:scale(0.8); } }

/* ── Main Content Area ───────────────────────────────────────── */
.main-content { flex: 1; display: flex; flex-direction: column; min-width: 0; height: 100vh; overflow: hidden; }

/* ── Monitor Header ──────────────────────────────────────────── */
.monitor-header {
  display: flex; align-items: center; gap: 12px;
  padding: 10px 24px; flex-shrink: 0;
  background: rgba(8,9,13,0.85);
  backdrop-filter: blur(20px) saturate(1.5);
  border-bottom: 1px solid var(--border-subtle);
}
.monitor-projects-btn {
  display: flex; align-items: center; gap: 6px;
  padding: 6px 14px; border-radius: 8px;
  border: 1px solid var(--border-subtle);
  background: var(--bg-card); color: var(--text-secondary);
  font-family: var(--font-sans); font-size: 12px; font-weight: 600;
  cursor: pointer; transition: var(--transition);
}
.monitor-projects-btn:hover { border-color: var(--border-accent); background: var(--bg-card-hover); color: var(--text-primary); }
.monitor-title-text { font-weight: 700; font-size: 15px; letter-spacing: -0.3px; }

/* ── Projects Drawer Toggle Button ───────────────────────────── */
.projects-toggle {
  display: flex; align-items: center; gap: 7px;
  padding: 7px 16px; border-radius: 8px; border: 1px solid var(--border-subtle);
  background: var(--bg-glass); color: var(--text-secondary);
  font-family: var(--font-sans); font-size: 13px; font-weight: 500;
  cursor: pointer; transition: var(--transition);
}
.projects-toggle:hover { border-color: var(--border-accent); color: var(--text-primary); background: rgba(99,102,241,0.06); }
.projects-toggle.open { border-color: var(--accent); color: var(--text-primary); background: rgba(99,102,241,0.1); }
.projects-toggle svg { width: 16px; height: 16px; flex-shrink: 0; }
.projects-toggle .current-name {
  max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  font-weight: 600; color: var(--text-primary);
}
.projects-toggle .chevron { transition: transform 0.2s ease; }
.projects-toggle.open .chevron { transform: rotate(180deg); }

/* ── Projects Drawer ─────────────────────────────────────────── */
.projects-drawer {
  position: fixed; top: 0; left: 68px; bottom: 0;
  width: 320px; z-index: 90;
  background: rgba(12, 13, 19, 0.97);
  backdrop-filter: blur(24px) saturate(1.4);
  border-right: 1px solid var(--border-subtle);
  transform: translateX(-100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex; flex-direction: column;
  box-shadow: 4px 0 32px rgba(0,0,0,0.4);
}
.projects-drawer.open { transform: translateX(0); }
.drawer-backdrop {
  position: fixed; inset: 0; left: 68px; z-index: 89;
  background: rgba(0,0,0,0.4);
  opacity: 0; pointer-events: none;
  transition: opacity 0.3s ease;
}
.drawer-backdrop.show { opacity: 1; pointer-events: auto; }

.drawer-header {
  padding: 16px 20px; border-bottom: 1px solid var(--border-subtle);
  display: flex; align-items: center; justify-content: space-between;
}
.drawer-title {
  font-size: 13px; font-weight: 700; color: var(--text-primary);
  text-transform: uppercase; letter-spacing: 0.5px;
}
.drawer-count {
  font-size: 11px; font-family: var(--font-mono); color: var(--text-muted);
}

.drawer-list {
  flex: 1; overflow-y: auto; padding: 8px 12px;
  scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.08) transparent;
}
.drawer-list::-webkit-scrollbar { width: 5px; }
.drawer-list::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 3px; }

/* Project item in drawer */
.drawer-project {
  margin-bottom: 4px; border-radius: var(--radius);
  overflow: hidden;
}
.drawer-project-btn {
  width: 100%; text-align: left; border: none;
  background: transparent; color: var(--text-secondary);
  padding: 10px 14px; cursor: pointer;
  font-family: var(--font-sans); font-size: 13px;
  display: flex; align-items: center; gap: 10px;
  border-radius: var(--radius);
  transition: var(--transition);
}
.drawer-project-btn:hover { background: rgba(255,255,255,0.04); color: var(--text-primary); }
.drawer-project-btn.active { background: rgba(99,102,241,0.1); color: var(--text-primary); }
.drawer-project-icon {
  width: 32px; height: 32px; border-radius: 8px; flex-shrink: 0;
  background: linear-gradient(135deg, rgba(99,102,241,0.15), rgba(139,92,246,0.1));
  border: 1px solid rgba(99,102,241,0.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 13px; font-weight: 700; color: var(--accent);
}
.drawer-project-btn.active .drawer-project-icon {
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: #fff; border-color: transparent;
}
.drawer-project-info { flex: 1; min-width: 0; }
.drawer-project-title {
  font-weight: 600; font-size: 13px;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.drawer-project-meta {
  font-size: 11px; color: var(--text-muted); margin-top: 1px;
}
.drawer-project-arrow {
  color: var(--text-muted); transition: transform 0.2s ease; flex-shrink: 0;
}
.drawer-project.expanded .drawer-project-arrow { transform: rotate(90deg); }

/* Run sub-list */
.drawer-runs {
  display: block;
  max-height: 168px;
  overflow-y: auto;
  padding: 2px 0 8px 12px;
  margin: 0 8px 0 44px;
  border-left: 1px solid var(--border-subtle);
}
.drawer-run-btn {
  width: 100%; text-align: left; border: none;
  background: transparent; color: var(--text-muted);
  padding: 6px 12px; cursor: pointer;
  font-family: var(--font-mono); font-size: 11.5px;
  border-radius: 6px; transition: var(--transition);
  display: flex; align-items: center; gap: 8px;
  margin-bottom: 1px;
}
.drawer-run-btn:hover { background: rgba(255,255,255,0.04); color: var(--text-primary); }
.drawer-run-btn.active {
  background: rgba(99,102,241,0.12); color: var(--accent); font-weight: 600;
}
.drawer-run-dot {
  width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0;
  background: var(--text-muted);
}
.drawer-run-btn.active .drawer-run-dot { background: var(--accent); box-shadow: 0 0 6px var(--accent); }
.drawer-run-btn:first-child .drawer-run-dot { background: var(--success); }
.drawer-run-btn:first-child:not(.active) { color: var(--text-secondary); }

.run-select { display: none; }

/* ── Generic panel ───────────────────────────────────────────── */
.panel {
  overflow-y: auto; padding: 16px;
  scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.08) transparent;
}
.panel::-webkit-scrollbar { width: 5px; }
.panel::-webkit-scrollbar-track { background: transparent; }
.panel::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 3px; }

.section-title {
  font-size: 11px; font-weight: 600; color: var(--text-muted);
  text-transform: uppercase; letter-spacing: 1px;
  margin-bottom: 12px; padding-left: 4px;
  display: flex; align-items: center; gap: 8px;
}
.section-title::before {
  content: ''; width: 3px; height: 12px; border-radius: 2px;
  background: linear-gradient(180deg, var(--accent), var(--accent-2));
}

/* ══════════════════════════════════════════════════════════════
   TAB 1: Live Monitor
   ══════════════════════════════════════════════════════════════ */
.view { display: none; flex: 1; }
.view.active { display: flex; flex-direction: column; }

#view-monitor {
  display: none; flex-direction: column;
  height: 100%;
}
#view-monitor.active { display: flex; }

.monitor-layout {
  flex: 1; display: grid;
  grid-template-columns: 340px 1fr 360px;
  grid-template-rows: auto 1fr;
  gap: 0; overflow: hidden;
}

/* Stats */
.overview-bar {
  grid-column: 1 / -1;
  display: flex; align-items: stretch; gap: 1px;
  padding: 16px 24px;
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border-subtle);
}
.stat-card {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 12px 16px;
  background: var(--bg-glass); border-radius: var(--radius);
  border: 1px solid var(--border-subtle); transition: var(--transition);
}
.stat-card:hover { border-color: var(--border-accent); background: var(--bg-card-hover); }
.stat-value {
  font-size: 24px; font-weight: 700; letter-spacing: -1px;
  background: linear-gradient(135deg, var(--text-primary), var(--accent));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
}
.stat-label { font-size: 11px; color: var(--text-muted); margin-top: 2px; text-transform: uppercase; letter-spacing: 0.5px; font-weight: 500; }
.progress-card { flex: 2; }
.progress-outer { width: 100%; height: 6px; background: rgba(255,255,255,0.05); border-radius: 3px; margin-top: 8px; overflow: hidden; }
.progress-inner {
  height: 100%; border-radius: 3px;
  background: linear-gradient(90deg, var(--accent), var(--accent-2), var(--cyan));
  background-size: 200% 100%; animation: shimmer 3s ease-in-out infinite;
  transition: width 0.8s cubic-bezier(0.4,0,0.2,1);
}
@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

/* ── Video Jobs Panel (inside Monitor) ────────────────────── */
.video-jobs-panel {
  grid-column: 1 / -1;
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border-subtle);
  padding: 12px 20px;
  display: flex; flex-direction: column; gap: 8px;
  max-height: 220px; overflow-y: auto;
  scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.08) transparent;
}
.video-jobs-panel:empty { display: none; }
.vj-header {
  display: flex; align-items: center; gap: 8px; margin-bottom: 4px;
}
.vj-header-title {
  font-size: 11px; font-weight: 700; color: var(--text-muted);
  text-transform: uppercase; letter-spacing: 0.8px;
}
.vj-header-count {
  font-size: 10px; font-family: var(--font-mono); color: var(--text-muted);
  background: rgba(255,255,255,0.04); padding: 1px 6px; border-radius: 4px;
}
.vj-cards { display: flex; gap: 10px; flex-wrap: wrap; }
.vj-card {
  flex: 1; min-width: 260px; max-width: 400px;
  background: var(--bg-card); border: 1px solid var(--border-subtle);
  border-radius: var(--radius); padding: 12px 14px;
  cursor: pointer; transition: var(--transition);
  position: relative; overflow: hidden;
}
.vj-card::before {
  content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px;
  background: var(--accent); opacity: 0; transition: var(--transition);
}
.vj-card:hover { border-color: var(--border-accent); background: var(--bg-card-hover); }
.vj-card:hover::before, .vj-card.selected::before { opacity: 1; }
.vj-card.selected { border-color: var(--accent); background: rgba(99,102,241,0.06); }
.vj-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; }
.vj-card-title {
  font-size: 13px; font-weight: 600; color: var(--text-primary);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 180px;
}
.vj-status {
  font-size: 10px; font-weight: 600; padding: 2px 8px; border-radius: 6px;
  text-transform: uppercase; letter-spacing: 0.5px;
}
.vj-status.running { color: var(--success); background: var(--success-glow); }
.vj-status.paused { color: #fbbf24; background: rgba(251,191,36,0.14); }
.vj-status.completed { color: var(--cyan); background: rgba(6,182,212,0.12); }
.vj-status.stopped { color: var(--warning); background: var(--warning-glow); }
.vj-status.crashed { color: var(--error); background: var(--error-glow); }
.vj-status.interrupted { color: var(--pink); background: rgba(236,72,153,0.12); }
.vj-progress-row { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
.vj-progress-bar { flex: 1; height: 4px; background: rgba(255,255,255,0.06); border-radius: 2px; overflow: hidden; }
.vj-progress-fill {
  height: 100%; border-radius: 2px; transition: width 0.5s ease;
  background: linear-gradient(90deg, var(--accent), var(--accent-2));
}
.vj-progress-text { font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); min-width: 42px; text-align: right; }
.vj-stage-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin: 2px 0 8px; }
.vj-stage-label { font-size: 11px; color: var(--text-secondary); }
.vj-stage-value { font-family: var(--font-mono); font-size: 10px; color: var(--text-muted); }
.vj-meta { font-size: 11px; color: var(--text-muted); display: flex; gap: 12px; }
.vj-actions { display: flex; gap: 6px; margin-top: 8px; }
.vj-btn {
  min-height: 34px;
  padding: 6px 14px;
  border-radius: 10px;
  border: 1px solid var(--border-subtle);
  background: linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.02));
  color: var(--text-secondary);
  font-family: var(--font-sans);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.2px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  cursor: pointer;
  transition: var(--transition);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);
  white-space: nowrap;
}
.vj-btn:hover:not(:disabled) {
  border-color: var(--border-accent);
  color: var(--text-primary);
  transform: translateY(-1px);
  box-shadow: 0 10px 20px rgba(0,0,0,0.18), inset 0 1px 0 rgba(255,255,255,0.04);
}
.vj-btn:active:not(:disabled) { transform: translateY(0); }
.vj-btn:disabled,
.vj-btn.loading {
  opacity: 0.68;
  cursor: not-allowed;
  pointer-events: none;
  transform: none;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.02);
}
.vj-btn.loading::after {
  content: '';
  width: 12px;
  height: 12px;
  border-radius: 50%;
  border: 2px solid rgba(255,255,255,0.16);
  border-top-color: currentColor;
  animation: spin 0.8s linear infinite;
}
.vj-btn.danger { border-color: rgba(239,68,68,0.3); color: var(--error); }
.vj-btn.danger:hover:not(:disabled) { background: var(--error-glow); }
.vj-btn.pause { border-color: rgba(245,158,11,0.3); color: var(--warning); }
.vj-btn.pause:hover:not(:disabled) { background: var(--warning-glow); }
.vj-btn.resume { border-color: rgba(16,185,129,0.3); color: var(--success); }
.vj-btn.resume:hover:not(:disabled) { background: var(--success-glow); }
.vj-btn.concat {
  border-color: rgba(99,102,241,0.34);
  color: #c7d2fe;
  background: linear-gradient(135deg, rgba(99,102,241,0.16), rgba(139,92,246,0.08));
}
.vj-btn.concat:hover:not(:disabled) {
  background: linear-gradient(135deg, rgba(99,102,241,0.22), rgba(139,92,246,0.12));
  border-color: rgba(99,102,241,0.55);
  color: #eef2ff;
}
.vj-btn.delete { border-color: rgba(239,68,68,0.22); color: rgba(254,202,202,0.96); }
.vj-btn.delete:hover:not(:disabled) { background: var(--error-glow); border-color: var(--error); color: #fff; }

.monitor-run-toolbar {
  padding: 14px 18px;
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: flex-start;
  gap: 14px;
  flex-wrap: wrap;
  background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.012));
  backdrop-filter: blur(18px);
}
.monitor-run-meta {
  display: flex;
  flex-direction: column;
  gap: 10px;
  min-width: 0;
  flex: 1;
}
.monitor-run-title-row {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}
.monitor-run-title {
  font-size: 16px;
  font-weight: 800;
  letter-spacing: -0.3px;
  color: var(--text-primary);
  cursor: pointer;
  border-radius: 6px;
  padding: 2px 6px;
  margin: -2px -6px;
  transition: background 0.15s;
}
.monitor-run-title:hover {
  background: rgba(255,255,255,0.06);
}
.monitor-run-title-edit {
  font-size: 16px;
  font-weight: 800;
  letter-spacing: -0.3px;
  color: var(--text-primary);
  background: rgba(255,255,255,0.06);
  border: 1.5px solid var(--accent);
  border-radius: 6px;
  padding: 2px 6px;
  margin: -2px -6px;
  outline: none;
  font-family: inherit;
  min-width: 120px;
  max-width: 400px;
}
.monitor-run-id {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  border-radius: 999px;
  border: 1px solid var(--border-subtle);
  background: rgba(255,255,255,0.03);
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-muted);
}
.monitor-run-summary {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.monitor-summary-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  border-radius: 999px;
  border: 1px solid var(--border-subtle);
  background: rgba(255,255,255,0.04);
  font-size: 11px;
  font-weight: 600;
  color: var(--text-secondary);
}
.monitor-summary-chip strong {
  color: var(--text-primary);
  font-weight: 800;
}
.monitor-summary-chip.accent {
  border-color: rgba(99,102,241,0.28);
  background: rgba(99,102,241,0.09);
  color: #c7d2fe;
}
.monitor-summary-chip.success {
  border-color: rgba(16,185,129,0.25);
  background: rgba(16,185,129,0.09);
  color: #a7f3d0;
}
.monitor-summary-chip.gold {
  border-color: rgba(255,215,0,0.26);
  background: rgba(255,215,0,0.08);
  color: #fef08a;
}
.monitor-summary-chip.busy {
  animation: pulse 1.5s ease-in-out infinite;
}
.monitor-run-actions {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.monitor-run-stat {
  font-size: 12px;
  color: var(--text-muted);
  white-space: nowrap;
}
.concat-mode-select {
  min-width: 132px;
  height: 34px;
  padding: 0 10px;
  border-radius: 10px;
  border: 1px solid var(--border-subtle);
  background: var(--bg-card);
  color: var(--text-secondary);
  font-size: 12px;
}
.concat-fade-input {
  width: 92px;
  height: 34px;
  padding: 0 10px;
  border-radius: 10px;
  border: 1px solid var(--border-subtle);
  background: var(--bg-card);
  color: var(--text-secondary);
  font-size: 12px;
}
.concat-fade-controls {
  display: flex;
  align-items: center;
  gap: 6px;
}
.concat-fade-presets {
  display: flex;
  align-items: center;
  gap: 4px;
}
.concat-fade-preset-btn {
  height: 30px;
  padding: 0 8px;
  border-radius: 8px;
  border: 1px solid var(--border-subtle);
  background: var(--bg-card);
  color: var(--text-muted);
  font-size: 11px;
  cursor: pointer;
}
.concat-fade-preset-btn:hover {
  border-color: var(--border-accent);
  color: var(--text-primary);
}

/* Monitor jobs panel collapse */
.monitor-jobs-panel {
  width: 340px;
  border-right: 1px solid var(--border-subtle);
  display: flex;
  flex-direction: column;
  transition: width 0.3s ease, min-width 0.3s ease;
  position: relative;
}
.monitor-jobs-panel.collapsed {
  width: 48px;
  min-width: 48px;
}
.monitor-jobs-panel.collapsed .monitor-jobs-header-title,
.monitor-jobs-panel.collapsed .monitor-jobs-content {
  display: none;
}
.monitor-jobs-header {
  padding: 12px 16px;
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.monitor-jobs-header-title {
  margin: 0;
}
.collapse-btn {
  position: absolute;
  right: -12px;
  top: 50%;
  transform: translateY(-50%);
  width: 24px;
  height: 48px;
  border-radius: 0 8px 8px 0;
  border: 1px solid var(--border-subtle);
  border-left: none;
  background: var(--bg-secondary);
  color: var(--text-muted);
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: var(--transition);
  z-index: 10;
}
.collapse-btn:hover {
  border-color: var(--border-accent);
  background: var(--bg-card-hover);
  color: var(--text-primary);
  right: -14px;
}
.collapse-btn svg {
  transition: transform 0.3s ease;
}
.monitor-jobs-panel.collapsed .collapse-btn {
  right: -12px;
}
.monitor-jobs-panel.collapsed .collapse-btn svg {
  transform: rotate(180deg);
}
.monitor-jobs-content {
  flex: 1;
  overflow-y: auto;
  padding: 12px;
}

/* Recent runs section in monitor */
.recent-runs-section {
  margin-top: 16px;
  padding-top: 12px;
  border-top: 1px solid var(--border-subtle);
}
.recent-runs-title {
  font-size: 11px; font-weight: 700; color: var(--text-muted);
  text-transform: uppercase; letter-spacing: 0.06em;
  display: flex; align-items: center; gap: 5px;
  margin-bottom: 8px; padding: 0 2px;
}
.recent-runs-list { display: flex; flex-direction: column; gap: 6px; }
.recent-run-card {
  display: flex; gap: 10px; align-items: center;
  padding: 8px; border-radius: 8px;
  border: 1px solid var(--border-subtle);
  background: var(--bg-card);
  cursor: pointer; transition: var(--transition);
}
.recent-run-card:hover { border-color: var(--border-accent); background: var(--bg-card-hover); }
.recent-run-thumb {
  flex-shrink: 0; width: 72px; height: 40px;
  border-radius: 5px; overflow: hidden; background: #000;
  position: relative;
}
.recent-run-thumb video { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
.recent-run-final-badge {
  position: absolute; bottom: 2px; right: 3px;
  font-size: 10px; line-height: 1;
}
.recent-run-info { flex: 1; min-width: 0; }
.recent-run-title {
  font-size: 12px; font-weight: 600; color: var(--text-primary);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.recent-run-meta { font-size: 10px; color: var(--text-muted); margin-top: 2px; }
.recent-run-progress { display: flex; align-items: center; gap: 5px; margin-top: 4px; }

/* Toast notification */
.toast-container {
  position: fixed; top: 20px; right: 20px; z-index: 9999;
  display: flex; flex-direction: column; gap: 8px;
}
.toast {
  padding: 12px 20px; border-radius: var(--radius);
  background: rgba(17, 19, 28, 0.95); backdrop-filter: blur(20px);
  border: 1px solid var(--border-subtle);
  color: var(--text-primary); font-size: 13px; font-weight: 500;
  box-shadow: var(--shadow-lg);
  animation: toastIn 0.3s ease forwards;
  max-width: 360px;
}
.toast.success { border-color: rgba(16,185,129,0.4); }
.toast.error { border-color: rgba(239,68,68,0.4); }
.toast.info { border-color: rgba(99,102,241,0.4); }
@keyframes toastIn { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: none; } }
@keyframes toastOut { from { opacity: 1; } to { opacity: 0; transform: translateX(20px); } }

/* Left panel */
.panel-left { background: var(--bg-secondary); border-right: 1px solid var(--border-subtle); }
.narrative-block {
  background: var(--bg-glass); border: 1px solid var(--border-subtle);
  border-radius: var(--radius); padding: 14px; margin-bottom: 16px;
  font-size: 13px; line-height: 1.8; color: var(--text-secondary);
  max-height: 200px; overflow-y: auto;
}
.scene-card {
  background: var(--bg-card); border: 1px solid var(--border-subtle);
  border-radius: var(--radius); padding: 14px; margin-bottom: 8px;
  cursor: pointer; transition: var(--transition); position: relative; overflow: hidden;
}
.scene-card::before { content:''; position:absolute; left:0; top:0; bottom:0; width:3px; background:var(--accent); opacity:0; transition:var(--transition); }
.scene-card:hover { border-color:var(--border-accent); background:var(--bg-card-hover); transform:translateX(2px); }
.scene-card:hover::before { opacity:1; }
.scene-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:6px; }
.scene-num { font-family:var(--font-mono); font-size:11px; font-weight:600; color:var(--accent); background:var(--accent-glow); padding:2px 8px; border-radius:4px; }
.scene-duration { font-family:var(--font-mono); font-size:11px; color:var(--text-muted); }
.scene-plot { font-size:13px; color:var(--text-secondary); line-height:1.6; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.scene-meta { display:flex; flex-wrap:wrap; gap:4px; margin-top:8px; }
.scene-tag { font-size:10px; padding:2px 6px; border-radius:4px; background:rgba(255,255,255,0.04); color:var(--text-muted); border:1px solid rgba(255,255,255,0.06); }
.scene-tag.char { color:var(--cyan); border-color:rgba(6,182,212,0.2); background:rgba(6,182,212,0.06); }
.scene-tag.mood { color:var(--pink); border-color:rgba(236,72,153,0.2); background:rgba(236,72,153,0.06); }
.scene-tag.camera { color:var(--warning); border-color:rgba(245,158,11,0.2); background:rgba(245,158,11,0.06); }
.scene-dialogue { margin-top:8px; padding:8px 10px; background:rgba(99,102,241,0.04); border-left:2px solid var(--accent); border-radius:0 6px 6px 0; font-size:12px; color:var(--text-secondary); line-height:1.6; }
.dialogue-speaker { color:var(--accent); font-weight:600; }

/* Center panel */
.panel-center { background:var(--bg-primary); display:flex; flex-direction:column; }
.units-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(320px,1fr)); gap:12px; padding:16px; overflow-y:auto; flex:1; }
.unit-card { background:var(--bg-card); border:1px solid var(--border-subtle); border-radius:var(--radius-lg); overflow:hidden; transition:var(--transition); }
.unit-card:hover { border-color:var(--border-accent); transform:translateY(-2px); box-shadow:var(--shadow-lg); }
.unit-video-wrap { position:relative; width:100%; aspect-ratio:16/9; background:#000; overflow:hidden; cursor:pointer; }
.unit-video-wrap video { width:100%; height:100%; object-fit:cover; }
.unit-video-placeholder { width:100%; height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; background:linear-gradient(135deg,rgba(99,102,241,0.06),rgba(139,92,246,0.04)); color:var(--text-muted); font-size:13px; gap:8px; }
.unit-placeholder-generating { color:var(--warning) !important; font-size:12px; font-weight:600; display:flex; align-items:center; gap:6px; }
.unit-placeholder-pending { color:var(--text-muted); font-size:12px; display:flex; align-items:center; gap:6px; }
.gen-spinner { width:14px; height:14px; border:2px solid rgba(245,158,11,0.3); border-top-color:var(--warning); border-radius:50%; animation:spin 0.8s linear infinite; flex-shrink:0; }
@keyframes spin { to { transform:rotate(360deg); } }
.gen-dots::after { content:''; animation:dots 1.4s steps(4,end) infinite; }
@keyframes dots { 0%,20%{content:''} 40%{content:'.'} 60%{content:'..'} 80%,100%{content:'...'} }
.play-overlay { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:rgba(0,0,0,0.3); opacity:0; transition:var(--transition); }
.unit-video-wrap:hover .play-overlay { opacity:1; }
.critique-overlay { position:absolute; bottom:8px; left:8px; display:flex; align-items:center; gap:5px; background:rgba(0,0,0,0.65); backdrop-filter:blur(4px); color:#a78bfa; font-size:11px; font-weight:600; padding:3px 8px; border-radius:20px; border:1px solid rgba(167,139,250,0.3); pointer-events:none; }
.play-btn { width:48px; height:48px; border-radius:50%; background:rgba(255,255,255,0.15); backdrop-filter:blur(12px); display:flex; align-items:center; justify-content:center; border:1px solid rgba(255,255,255,0.2); transition:var(--transition); }
.play-btn:hover { transform:scale(1.1); background:rgba(255,255,255,0.25); }
.unit-info { padding: 14px; }
.unit-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:8px; }
.unit-id { font-family:var(--font-mono); font-size:12px; font-weight:600; }
.unit-status { font-size:11px; font-weight:600; padding:3px 10px; border-radius:20px; text-transform:uppercase; letter-spacing:0.5px; }
.unit-status.completed { color:var(--success); background:var(--success-glow); }
.unit-status.in_progress { color:var(--warning); background:var(--warning-glow); animation:pulse 2s ease-in-out infinite; }
.unit-status.queued { color:var(--accent); background:rgba(99,102,241,0.12); }
.unit-status.draft { color:#38bdf8; background:rgba(56,189,248,0.12); }
.unit-status.critiquing { color:#a78bfa; background:rgba(167,139,250,0.12); animation:pulse 2s ease-in-out infinite; }
.unit-status.failed { color:var(--error); background:var(--error-glow); }
.unit-status.pending { color:var(--text-muted); background:rgba(255,255,255,0.04); }
.unit-group { font-size:13px; color:var(--text-secondary); margin-bottom:4px; font-weight:500; }
.unit-scenes { font-size:11px; color:var(--text-muted); margin-bottom:8px; display:flex; align-items:center; gap:4px; }
.unit-scenes span { font-family:var(--font-mono); }
.unit-prompt-preview { font-size:12px; color:var(--text-muted); line-height:1.6; padding:8px; background:var(--bg-glass); border-radius:8px; border:1px solid var(--border-subtle); margin-top:8px; max-height:80px; overflow-y:auto; scrollbar-width:thin; scrollbar-color:rgba(255,255,255,0.08) transparent; }
.unit-prompt-preview::-webkit-scrollbar { width:4px; }
.unit-prompt-preview::-webkit-scrollbar-thumb { background:rgba(255,255,255,0.1); border-radius:2px; }
.unit-expand-btn { display:flex; align-items:center; justify-content:center; gap:4px; margin-top:8px; padding:5px; border-radius:6px; border:1px solid var(--border-subtle); background:var(--bg-glass); color:var(--text-muted); font-size:11px; font-family:var(--font-sans); cursor:pointer; transition:var(--transition); width:100%; }
.unit-expand-btn:hover { border-color:var(--border-accent); color:var(--text-primary); background:rgba(99,102,241,0.06); }
.unit-attempts { display:flex; gap:4px; margin-top:10px; }
.attempt-dot { width:22px; height:22px; border-radius:6px; display:flex; align-items:center; justify-content:center; font-size:10px; font-weight:600; font-family:var(--font-mono); cursor:pointer; transition:var(--transition); border:1px solid transparent; }
.attempt-dot.success { background:var(--success-glow); color:var(--success); border-color:rgba(16,185,129,0.3); }
.attempt-dot.failed { background:var(--error-glow); color:var(--error); border-color:rgba(239,68,68,0.3); }
.attempt-dot.pending { background:rgba(99,102,241,0.14); color:var(--accent); border-color:rgba(99,102,241,0.32); }
.attempt-dot.running { background:var(--warning-glow); color:var(--warning); border-color:rgba(245,158,11,0.32); }
.attempt-dot:hover { transform:scale(1.15); }
.attempt-dot.viewing { outline:2px solid var(--accent); outline-offset:1px; transform:scale(1.15); }
.attempt-dot.final-picked { box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.9) inset; border-color: rgba(245,158,11,0.55); }
.attempt-meta-badges { display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }
.attempt-meta-badge {
  display:inline-flex; align-items:center; gap:4px;
  padding:2px 8px; border-radius:999px;
  font-size:10px; font-weight:700; letter-spacing:0.3px;
  border:1px solid transparent;
}
.attempt-meta-badge.recovered { color:#38bdf8; background:rgba(56,189,248,0.12); border-color:rgba(56,189,248,0.28); }
.attempt-meta-badge.selector { color:#f59e0b; background:rgba(245,158,11,0.12); border-color:rgba(245,158,11,0.28); }
.attempt-meta-badge.critique-failed { color:var(--warning); background:rgba(245,158,11,0.12); border-color:rgba(245,158,11,0.28); }
.attempt-meta-badge.critique-missing { color:var(--text-muted); background:rgba(255,255,255,0.05); border-color:rgba(255,255,255,0.12); }
.unit-critique { margin-top:10px; padding:10px; background:var(--bg-glass); border:1px solid var(--border-subtle); border-radius:8px; font-size:12px; }
.unit-actions { display:flex; flex-direction:column; gap:8px; margin-top:10px; }
.unit-action-row { display:flex; gap:8px; align-items:center; flex-wrap:wrap; }
.unit-action-row input[type="number"] { width:84px; }
.unit-action-input, .unit-action-textarea {
  width:100%; border-radius:8px; border:1px solid var(--border-subtle);
  background:var(--bg-glass); color:var(--text-secondary); font-family:var(--font-sans);
}
.unit-action-input { padding:7px 10px; font-size:12px; }
.unit-action-textarea { min-height:96px; padding:10px 12px; resize:vertical; font-size:12px; line-height:1.6; }
.unit-action-note { font-size:11px; color:var(--text-muted); line-height:1.5; }
.unit-action-hint { font-size: 11px; color: var(--text-muted); }
.unit-action-tooltip { display: inline-flex; }
.prompt-readonly {
  min-height: 110px;
  padding: 10px 12px;
  border-radius: 10px;
  border: 1px solid var(--border-subtle);
  background: var(--bg-glass);
}
.prompt-editor {
  min-height: 110px;
  padding: 10px 12px;
  border-radius: 10px;
  border: 1px solid var(--border-subtle);
  background: var(--bg-glass);
  color: var(--text-secondary);
  font-size: 12px;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
  outline: none;
  cursor: text;
}
.prompt-editor:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-glow);
}
.prompt-editor.is-empty::before {
  content: attr(data-placeholder);
  color: var(--text-muted);
}
.prompt-editor-text {
  white-space: pre-wrap;
}
.prompt-token {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  max-width: 100%;
  padding: 2px 8px 2px 4px;
  margin: 0 2px;
  border-radius: 999px;
  background: rgba(99,102,241,0.14);
  border: 1px solid rgba(99,102,241,0.26);
  color: var(--text-primary);
  vertical-align: baseline;
  cursor: grab;
  user-select: none;
}
.prompt-token.dragging {
  opacity: 0.55;
  cursor: grabbing;
}
.prompt-token-image {
  width: 20px;
  height: 20px;
  border-radius: 999px;
  object-fit: cover;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.14);
  flex-shrink: 0;
}
.prompt-token-fallback {
  width: 20px;
  height: 20px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.08);
  color: var(--text-muted);
  font-size: 10px;
  flex-shrink: 0;
}
.prompt-token-label {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  min-width: 0;
}
.prompt-token-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 160px;
}
.prompt-preview-raw {
  margin-top: 8px;
  font-size: 11px;
  color: var(--text-muted);
  line-height: 1.5;
  word-break: break-all;
}
.prompt-mention-menu {
  position: fixed;
  z-index: 1200;
  min-width: 240px;
  max-width: 320px;
  max-height: 260px;
  overflow-y: auto;
  padding: 6px;
  border-radius: 12px;
  border: 1px solid var(--border-subtle);
  background: rgba(17,19,28,0.98);
  box-shadow: 0 20px 60px rgba(0,0,0,0.45);
  display: none;
}
.prompt-mention-menu.show {
  display: block;
}
.prompt-mention-group {
  padding: 6px 8px 4px;
  font-size: 10px;
  font-weight: 700;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.6px;
}
.prompt-mention-item {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 8px 10px;
  border-radius: 10px;
  border: none;
  background: transparent;
  color: var(--text-secondary);
  text-align: left;
  cursor: pointer;
}
.prompt-mention-item:hover,
.prompt-mention-item.active {
  background: rgba(99,102,241,0.12);
  color: var(--text-primary);
}
.prompt-mention-thumb {
  width: 28px;
  height: 28px;
  border-radius: 8px;
  object-fit: cover;
  background: rgba(255,255,255,0.08);
  flex-shrink: 0;
  pointer-events: none;
  user-select: none;
  -webkit-user-drag: none;
}
.prompt-mention-meta {
  min-width: 0;
  display: flex;
  flex-direction: column;
}
.prompt-mention-name {
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.prompt-mention-type {
  font-size: 10px;
  color: var(--text-muted);
}
.prompt-render-block {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  line-height: 1.7;
}
.prompt-render-text {
  white-space: pre-wrap;
  color: var(--text-secondary);
}
.final-attempt-badge {
  display:inline-flex; align-items:center; gap:4px; padding:2px 8px; border-radius:999px;
  background:rgba(245,158,11,0.12); color:var(--warning); border:1px solid rgba(245,158,11,0.24);
  font-size:10px; font-weight:700; letter-spacing:0.3px;
}
.max-attempts-label {
  display:inline-flex; align-items:center; gap:4px; font-size:11px; color:var(--text-muted); white-space:nowrap;
}
.max-attempts-input {
  width:42px; padding:2px 4px; border:1px solid var(--border-subtle); border-radius:var(--radius);
  background:var(--bg-primary); color:var(--text-primary); font-size:11px; text-align:center;
}
.max-attempts-input:focus { border-color:var(--accent); outline:none; }
.critique-score { display:flex; align-items:center; gap:8px; margin-bottom:8px; }
.score-circle { width:36px; height:36px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:14px; font-family:var(--font-mono); border:2px solid; }
.score-high { color:var(--success); border-color:var(--success); }
.score-mid { color:var(--warning); border-color:var(--warning); }
.score-low { color:var(--error); border-color:var(--error); }
.critique-rec { font-weight:600; text-transform:uppercase; letter-spacing:0.5px; }
.critique-rec.ACCEPT { color:var(--success); }
.critique-rec.RETRY { color:var(--warning); }
.critique-items { color:var(--text-muted); line-height:1.6; }
.critique-items li { margin-bottom:2px; }

/* Right panel */
.panel-right { background:var(--bg-secondary); border-left:1px solid var(--border-subtle); }
.asset-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin-bottom:16px; }
.asset-card { position:relative; border-radius:var(--radius); overflow:hidden; cursor:pointer; border:1px solid var(--border-subtle); transition:var(--transition); aspect-ratio:1; }
.asset-card:hover { border-color:var(--border-accent); transform:scale(1.02); }
.asset-card img { width:100%; height:100%; object-fit:cover; }
.asset-label { position:absolute; bottom:0; left:0; right:0; padding:20px 8px 6px; background:linear-gradient(transparent,rgba(0,0,0,0.8)); font-size:11px; font-weight:500; color:#fff; }
.asset-card-wide { grid-column:1/-1; aspect-ratio:16/9; }
.style-info { background:var(--bg-glass); border:1px solid var(--border-subtle); border-radius:var(--radius); padding:14px; margin-bottom:16px; }
.style-tag { display:inline-block; font-size:11px; padding:3px 10px; border-radius:20px; margin:2px 4px 2px 0; background:linear-gradient(135deg,var(--accent-glow),rgba(139,92,246,0.1)); border:1px solid var(--border-accent); color:var(--accent); }
.char-info { background:var(--bg-glass); border:1px solid var(--border-subtle); border-radius:var(--radius); padding:12px; margin-bottom:8px; transition:var(--transition); }
.char-info:hover { border-color:var(--border-accent); }
.char-info-header { display:flex; align-items:center; gap:10px; margin-bottom:6px; }
.char-avatar { width:36px; height:36px; border-radius:8px; object-fit:cover; border:1px solid var(--border-subtle); }
.char-name { font-weight:600; font-size:13px; }
.char-personality { font-size:11px; color:var(--text-muted); }
.char-desc { font-size:12px; color:var(--text-secondary); line-height:1.6; margin-top:4px; }

.empty-state { display:flex; flex-direction:column; align-items:center; justify-content:center; height:100%; color:var(--text-muted); gap:12px; font-size:14px; padding:40px; text-align:center; }
.empty-state svg { opacity:0.2; }

/* ══════════════════════════════════════════════════════════════
   TAB 2: Repository
   ══════════════════════════════════════════════════════════════ */
#view-repo { height: 100%; }
#view-repo.active { display: flex; flex-direction: row; }

.repo-sidebar {
  width: 280px; min-width: 280px;
  background: var(--bg-secondary);
  border-right: 1px solid var(--border-subtle);
  overflow-y: auto; padding: 16px;
  display: flex; flex-direction: column; gap: 6px;
}

.repo-sidebar-header {
  font-size: 11px; font-weight: 600; color: var(--text-muted);
  text-transform: uppercase; letter-spacing: 1px;
  padding: 8px 4px; margin-bottom: 4px;
  display: flex; align-items: center; justify-content: space-between;
}

.repo-project-btn {
  width: 100%; text-align: left;
  background: var(--bg-glass); border: 1px solid var(--border-subtle);
  border-radius: var(--radius); padding: 12px 14px;
  color: var(--text-primary); cursor: pointer;
  transition: var(--transition); font-family: var(--font-sans);
}
.repo-project-btn:hover { border-color: var(--border-accent); background: var(--bg-card-hover); transform: translateX(2px); }
.repo-project-btn.active { border-color: var(--accent); background: rgba(99,102,241,0.08); }
.repo-project-name { font-size: 13px; font-weight: 600; margin-bottom: 4px; display: flex; align-items: center; gap: 6px; }
.repo-project-name .title-text { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.repo-project-stats { display: flex; gap: 12px; font-size: 11px; color: var(--text-muted); }
.repo-project-stats span { display: flex; align-items: center; gap: 3px; }
.repo-project-theme { font-size: 11px; color: var(--text-muted); margin-top: 4px; }

/* Monitor button in repo run cards */
.repo-monitor-btn {
  display: inline-flex; align-items: center; gap: 4px;
  padding: 4px 10px; border-radius: 6px;
  background: rgba(99,102,241,0.1); border: 1px solid rgba(99,102,241,0.25);
  color: var(--accent); font-size: 11px; font-weight: 600;
  font-family: var(--font-sans); cursor: pointer;
  transition: var(--transition); white-space: nowrap;
}
.repo-monitor-btn:hover { background: rgba(99,102,241,0.2); border-color: var(--accent); transform: translateY(-1px); }
.repo-monitor-btn svg { flex-shrink: 0; }

/* ── Browse Mode Layout ─────────────────────────────────────── */
.browse-layout { display: flex; flex: 1; overflow: hidden; }
.browse-sidebar {
  width: 33%; min-width: 320px; max-width: 420px; overflow-y: auto; padding: 20px;
  background: var(--bg-secondary); border-right: 1px solid var(--border-subtle);
  scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.08) transparent;
}
.browse-main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
.browse-detail { flex: 1; display: flex; gap: 0; overflow: hidden; }
.browse-detail-shell {
  flex: 1;
  min-height: 0;
  padding: 16px 18px 18px;
}
.browse-detail-grid {
  height: 100%;
  min-height: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  grid-template-rows: auto minmax(0, 1fr);
  gap: 16px;
  padding: 18px 20px;
  border-radius: var(--radius-xl);
  border: 1px solid rgba(255,255,255,0.06);
  background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.015));
  box-shadow: var(--shadow-lg);
  overflow: hidden;
}
.browse-detail-grid .browse-unit-meta {
  grid-column: 1 / -1;
  margin-bottom: 0;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border-subtle);
}
.browse-video-area {
  flex: 1; display: flex; overflow: hidden;
}
.browse-video-col {
  flex: 0 0 40%; max-width: 40%; display: flex; flex-direction: column;
  align-items: center; justify-content: center; padding: 20px;
  border-left: 1px solid var(--border-subtle);
}
.browse-info-col {
  flex: 0 0 60%; max-width: 60%; display: flex; flex-direction: column; padding: 20px; overflow-y: auto;
}
.browse-video-player {
  width: 100%; aspect-ratio: 16/9; background: #000;
  border-radius: var(--radius-lg); overflow: hidden; position: relative;
}
.browse-video-player video { width: 100%; height: 100%; object-fit: contain; }
.browse-video-player .no-video {
  display: flex; align-items: center; justify-content: center;
  width: 100%; height: 100%; color: var(--text-muted); font-size: 13px;
}
.browse-unit-meta { margin-bottom: 16px; }
.browse-unit-title { font-size: 16px; font-weight: 700; margin-bottom: 4px; }
.browse-unit-subtitle { font-size: 12px; color: var(--text-muted); margin-bottom: 12px; }
.browse-prompt-block {
  background: var(--bg-glass); border: 1px solid var(--border-subtle);
  border-radius: var(--radius); padding: 14px; margin-bottom: 12px;
  font-size: 13px; line-height: 1.8; color: var(--text-secondary);
  overflow-y: auto; white-space: pre-wrap;
}
.browse-prompt-label {
  font-size: 11px; font-weight: 600; color: var(--text-muted);
  text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px;
}
/* Filmstrip */
.browse-filmstrip {
  flex-shrink: 0; border-top: 1px solid var(--border-subtle);
  background: rgba(8,9,13,0.9); padding: 12px 20px;
  display: flex; flex-direction: column; gap: 8px;
}
.browse-filmstrip-header {
  display: flex; align-items: center; justify-content: space-between;
  font-size: 12px; color: var(--text-muted);
}
.browse-filmstrip-scroll {
  display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px;
  scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.1) transparent;
}
.browse-filmstrip-item {
  flex-shrink: 0; width: 140px; cursor: pointer;
  border-radius: 8px; overflow: hidden; border: 2px solid transparent;
  transition: var(--transition); position: relative;
  background: var(--bg-card);
}
.browse-filmstrip-item:hover { border-color: var(--border-accent); transform: translateY(-2px); }
.browse-filmstrip-item.active { border-color: var(--accent); box-shadow: 0 0 12px var(--accent-glow); }
.browse-filmstrip-thumb { width: 100%; aspect-ratio: 16/9; background: #000; overflow: hidden; }
.browse-filmstrip-thumb video { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
.browse-filmstrip-thumb .thumb-placeholder {
  width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
  color: var(--text-muted); font-size: 10px;
}
.browse-filmstrip-label {
  padding: 4px 8px; font-size: 11px; font-weight: 600;
  display: flex; align-items: center; justify-content: space-between;
  color: var(--text-primary);
}
.browse-filmstrip-label .unit-num { color: var(--accent); }
.browse-filmstrip-label .unit-dur { color: var(--text-muted); font-weight: 400; font-size: 10px; }
/* Final video card in filmstrip */
.browse-filmstrip-item.final-card {
  border-color: rgba(255,215,0,0.3);
  background: linear-gradient(135deg, rgba(255,215,0,0.06) 0%, var(--bg-card) 100%);
}
.browse-filmstrip-item.final-card:hover { border-color: rgba(255,215,0,0.7); }
.browse-filmstrip-item.final-card.active { border-color: #ffd700; box-shadow: 0 0 14px rgba(255,215,0,0.35); }
.browse-filmstrip-item.final-card .browse-filmstrip-label { color: #ffd700; }
.filmstrip-final-divider {
  flex-shrink: 0; width: 1px; background: var(--border-subtle);
  margin: 4px 6px; align-self: stretch;
}
/* Full-screen video detail (final mode) */
.browse-detail-final {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
}
.final-stage-shell {
  flex: 1;
  min-height: 0;
  margin: 16px 18px 18px;
  border-radius: var(--radius-xl);
  border: 1px solid rgba(255,255,255,0.07);
  background:
    radial-gradient(circle at top right, rgba(99,102,241,0.12), transparent 28%),
    radial-gradient(circle at top left, rgba(255,215,0,0.09), transparent 24%),
    linear-gradient(180deg, rgba(10,12,18,0.98), rgba(6,7,11,0.98));
  box-shadow: var(--shadow-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.final-stage-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
  padding: 18px 20px 12px;
  flex-wrap: wrap;
}
.final-stage-label {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 6px 10px;
  border-radius: 999px;
  border: 1px solid rgba(255,215,0,0.28);
  background: rgba(255,215,0,0.08);
  color: #fde68a;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.9px;
}
.final-stage-title {
  margin-top: 12px;
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -0.5px;
  color: var(--text-primary);
}
.final-stage-subtitle {
  margin-top: 8px;
  font-size: 13px;
  line-height: 1.7;
  color: var(--text-secondary);
}
.final-stage-info {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-top: 14px;
}
.final-stage-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  align-items: center;
}
.final-stage-player {
  flex: 1;
  min-height: 0;
  padding: 0 18px 18px;
}
.final-stage-video-wrap {
  width: 100%;
  height: 100%;
  min-height: 320px;
  border-radius: 18px;
  overflow: hidden;
  background:
    radial-gradient(circle at center, rgba(255,255,255,0.05), transparent 45%),
    #000;
  border: 1px solid rgba(255,255,255,0.08);
}
.final-stage-video-wrap video {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

/* Sidebar sections */
.browse-section-title {
  font-size: 11px; font-weight: 700; color: var(--text-muted);
  text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 10px;
  margin-top: 20px;
}
.browse-section-title:first-child { margin-top: 0; }
.browse-add-asset-bar {
  margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--border-subtle);
}
.browse-add-asset-title {
  font-size: 11px; font-weight: 700; color: var(--text-muted);
  text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 10px;
}
.browse-add-asset-btns { display: flex; gap: 8px; }
.browse-add-asset-cat-btn {
  flex: 1; padding: 8px 0; border-radius: var(--radius); border: 1px dashed var(--border-accent);
  background: transparent; color: var(--accent); font-size: 12px; font-weight: 600;
  font-family: var(--font-sans); cursor: pointer; transition: var(--transition);
  text-align: center;
}
.browse-add-asset-cat-btn:hover { background: rgba(99,102,241,0.1); border-style: solid; }

/* Add-entity modal */
.add-entity-modal-backdrop {
  position: fixed; inset: 0; z-index: 1100; background: rgba(0,0,0,0.55);
  display: none; align-items: center; justify-content: center;
}
.add-entity-modal-backdrop.show { display: flex; }
.add-entity-modal {
  background: var(--bg-card); border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg); box-shadow: var(--shadow-lg);
  width: 420px; max-width: 92vw; padding: 24px; position: relative;
}
.add-entity-modal h3 { font-size: 16px; font-weight: 700; margin: 0 0 16px; }
.add-entity-modal .form-row { margin-bottom: 14px; }
.add-entity-modal .form-row label { display: block; font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 5px; }
.add-entity-modal .form-row input,
.add-entity-modal .form-row select,
.add-entity-modal .form-row textarea {
  width: 100%; padding: 8px 10px; border-radius: var(--radius); border: 1px solid var(--border-subtle);
  background: var(--bg-glass); color: var(--text-primary); font-size: 13px; font-family: var(--font-sans);
}
.add-entity-modal .form-row textarea { resize: vertical; min-height: 60px; }
.add-entity-modal .image-source-tabs { display: flex; gap: 2px; margin-bottom: 10px; background: rgba(255,255,255,0.03); border-radius: 8px; padding: 3px; }
.add-entity-modal .image-source-tab {
  flex: 1; padding: 7px 0; border: none; border-radius: 6px; background: transparent;
  color: var(--text-muted); font-size: 12px; font-weight: 600; font-family: var(--font-sans);
  cursor: pointer; transition: var(--transition); text-align: center;
}
.add-entity-modal .image-source-tab.active { background: rgba(99,102,241,0.15); color: var(--text-primary); }
.add-entity-modal .image-source-tab:hover:not(.active) { color: var(--text-secondary); }
.add-entity-modal .library-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(70px, 1fr)); gap: 8px;
  max-height: 180px; overflow-y: auto; padding: 4px 0;
}
.add-entity-modal .library-grid-item {
  aspect-ratio: 1; border-radius: var(--radius); overflow: hidden; cursor: pointer;
  border: 2px solid transparent; transition: var(--transition);
}
.add-entity-modal .library-grid-item:hover { border-color: var(--border-accent); }
.add-entity-modal .library-grid-item.selected { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
.add-entity-modal .library-grid-item img { width: 100%; height: 100%; object-fit: cover; }
.add-entity-modal .local-upload-zone {
  border: 1px dashed var(--border-accent); border-radius: var(--radius); padding: 20px;
  text-align: center; color: var(--text-muted); font-size: 12px; cursor: pointer; transition: var(--transition);
}
.add-entity-modal .local-upload-zone:hover { background: rgba(99,102,241,0.06); }
.add-entity-modal .local-upload-zone.has-file { border-style: solid; color: var(--accent); }
.add-entity-modal .modal-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 18px; }
.browse-narrative {
  font-size: 13px; line-height: 1.8; color: var(--text-secondary);
  max-height: 200px; overflow-y: auto; margin-bottom: 8px;
  background: var(--bg-glass); border: 1px solid var(--border-subtle);
  border-radius: var(--radius); padding: 12px;
}
.browse-char-card {
  display: flex; gap: 0; overflow: hidden; position: relative; flex-wrap: wrap;
  background: var(--bg-glass); border: 1px solid var(--border-subtle);
  border-radius: var(--radius); margin-bottom: 8px; transition: var(--transition);
}
.browse-char-card:hover { border-color: var(--border-accent); }
.browse-char-avatar {
  width: 33%; flex-shrink: 0; overflow: hidden; cursor: pointer;
  background: var(--bg-card);
}
.browse-char-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
.browse-char-info { flex: 1; min-width: 0; padding: 10px; }
.browse-char-name { font-size: 13px; font-weight: 600; margin-bottom: 2px; }
.browse-char-desc { font-size: 11px; color: var(--text-muted); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }
.browse-loc-card {
  display: flex; gap: 0; overflow: hidden; position: relative; flex-wrap: wrap;
  background: var(--bg-glass); border: 1px solid var(--border-subtle);
  border-radius: var(--radius); margin-bottom: 8px; transition: var(--transition);
}
.browse-loc-card:hover { border-color: var(--border-accent); }
.browse-loc-avatar {
  width: 33%; flex-shrink: 0; overflow: hidden; cursor: pointer;
  background: var(--bg-card);
}
.browse-loc-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
.browse-loc-info { flex: 1; min-width: 0; padding: 10px; }
.browse-loc-name { font-size: 13px; font-weight: 600; margin-bottom: 2px; }

/* Regenerate sheet button on entity cards */
.regen-sheet-btn {
  position: absolute; bottom: 6px; right: 6px; z-index: 2;
  font-size: 10px; padding: 3px 10px;
  border-radius: 12px; border: 1px solid rgba(139,92,246,0.3);
  background: rgba(0,0,0,0.65); color: #c4b5fd;
  cursor: pointer; transition: var(--transition);
  backdrop-filter: blur(4px); white-space: nowrap;
}
.regen-sheet-btn:hover { background: rgba(139,92,246,0.35); color: #fff; border-color: rgba(139,92,246,0.6); }
.regen-sheet-btn:disabled { opacity: 0.5; cursor: not-allowed; }
.regen-sheet-edit {
  width: 100%; padding: 8px 10px; box-sizing: border-box;
  background: var(--bg-tertiary, rgba(0,0,0,0.2)); border-top: 1px solid var(--border-subtle);
}
.regen-sheet-edit textarea {
  width: 100%; min-height: 60px; max-height: 140px; resize: vertical;
  background: var(--bg-card); color: var(--text-primary);
  border: 1px solid var(--border-subtle); border-radius: 6px;
  padding: 6px 8px; font-size: 12px; line-height: 1.5;
  font-family: inherit; box-sizing: border-box;
}
.regen-sheet-edit textarea:focus { border-color: var(--border-accent); outline: none; }
.regen-sheet-edit-actions {
  display: flex; gap: 6px; margin-top: 6px; justify-content: flex-end;
}
.regen-sheet-edit-actions button {
  font-size: 11px; padding: 4px 14px; border-radius: 6px; cursor: pointer;
  border: 1px solid var(--border-subtle); transition: var(--transition);
}
.regen-sheet-edit-actions .regen-cancel {
  background: transparent; color: var(--text-muted);
}
.regen-sheet-edit-actions .regen-cancel:hover { color: var(--text-primary); }
.regen-sheet-edit-actions .regen-submit {
  background: rgba(139,92,246,0.2); color: #c4b5fd; border-color: rgba(139,92,246,0.4);
}
.regen-sheet-edit-actions .regen-submit:hover { background: rgba(139,92,246,0.35); color: #fff; }
.regen-sheet-edit-actions .regen-submit:disabled { opacity: 0.5; cursor: not-allowed; }
.regen-sheet-loading {
  position: absolute; inset: 0; z-index: 3;
  display: flex; align-items: center; justify-content: center;
  background: rgba(0,0,0,0.55); border-radius: var(--radius);
  color: #c4b5fd; font-size: 12px; gap: 6px;
  backdrop-filter: blur(2px);
}
.browse-loc-desc { font-size: 11px; color: var(--text-muted); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; }

/* Main repo content */
.repo-content {
  flex: 1; overflow-y: auto; padding: 0;
  display: flex; flex-direction: column;
}

/* Repo header with project info */
.repo-project-header {
  padding: 24px 32px 20px;
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border-subtle);
}
.repo-project-title {
  font-size: 22px; font-weight: 700; margin-bottom: 6px;
  background: linear-gradient(135deg, var(--text-primary), var(--accent));
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
}
.repo-project-subtitle { font-size: 13px; color: var(--text-secondary); margin-bottom: 12px; }
.repo-project-tags { display: flex; flex-wrap: wrap; gap: 6px; }

/* Repo run list */
.repo-runs-container { flex: 1; padding: 24px 32px; overflow-y: auto; }

.repo-run-card {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  margin-bottom: 20px;
  overflow: hidden;
  transition: var(--transition);
}
.repo-run-card:hover { border-color: var(--border-accent); }

.repo-run-header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid var(--border-subtle);
  cursor: pointer;
}
.repo-run-header:hover { background: var(--bg-card-hover); }
.repo-run-id {
  font-family: var(--font-mono); font-weight: 600; font-size: 14px;
  display: flex; align-items: center; gap: 10px;
}
.repo-run-date { font-size: 12px; color: var(--text-muted); font-family: var(--font-sans); font-weight: 400; }
.repo-run-badges { display: flex; gap: 8px; align-items: center; }
.repo-badge {
  font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 20px;
  display: flex; align-items: center; gap: 4px;
}
.repo-badge.videos { color: var(--accent); background: var(--accent-glow); }
.repo-badge.images { color: var(--cyan); background: rgba(6,182,212,0.12); }
.repo-badge.progress-badge { color: var(--success); background: var(--success-glow); }
.repo-badge.progress-partial { color: var(--warning); background: var(--warning-glow); }

.repo-run-body { display: none; padding: 16px 20px; }
.repo-run-card.expanded .repo-run-body { display: block; }

/* Run detail: video grid */
.repo-videos-label {
  font-size: 11px; font-weight: 600; color: var(--text-muted);
  text-transform: uppercase; letter-spacing: 0.5px;
  margin-bottom: 10px;
}
.repo-video-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 10px; margin-bottom: 16px;
}
.repo-video-thumb {
  position: relative; aspect-ratio: 16/9; border-radius: var(--radius);
  overflow: hidden; cursor: pointer;
  border: 1px solid var(--border-subtle); transition: var(--transition);
  background: #000;
}
.repo-video-thumb:hover { border-color: var(--border-accent); transform: scale(1.02); }
.repo-video-thumb video { width: 100%; height: 100%; object-fit: cover; pointer-events: none; }
.repo-video-label {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 16px 10px 6px;
  background: linear-gradient(transparent, rgba(0,0,0,0.8));
  font-size: 11px; color: #fff; font-family: var(--font-mono);
  display: flex; align-items: center; justify-content: space-between;
}
.repo-video-thumb .play-overlay { opacity: 0; }
.repo-video-thumb:hover .play-overlay { opacity: 1; }

/* Run detail: image grid */
.repo-image-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 8px; margin-bottom: 16px;
}
.repo-image-thumb {
  position: relative; aspect-ratio: 1; border-radius: var(--radius);
  overflow: hidden; cursor: pointer;
  border: 1px solid var(--border-subtle); transition: var(--transition);
}
.repo-image-thumb:hover { border-color: var(--border-accent); transform: scale(1.03); }
.repo-image-thumb img { width: 100%; height: 100%; object-fit: cover; }
.repo-image-thumb .asset-label { font-size: 10px; }

/* Run detail: unit info grid */
.repo-units-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 8px; margin-bottom: 16px;
}
.repo-unit-mini {
  background: var(--bg-glass); border: 1px solid var(--border-subtle);
  border-radius: 8px; padding: 10px 12px; font-size: 12px;
  display: flex; align-items: center; gap: 10px;
}
.repo-unit-mini-id { font-family: var(--font-mono); font-weight: 600; white-space: nowrap; }
.repo-unit-mini-group { color: var(--text-secondary); flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* Repo totals bar */
.repo-totals {
  padding: 16px 32px;
  background: var(--bg-secondary);
  border-bottom: 1px solid var(--border-subtle);
  display: flex; gap: 24px; align-items: center;
}
.repo-total-item {
  display: flex; align-items: center; gap: 6px;
  font-size: 13px; color: var(--text-secondary);
}
.repo-total-item strong {
  font-size: 18px; font-weight: 700; color: var(--text-primary);
  font-family: var(--font-mono);
}

/* Expand arrow */
.expand-arrow {
  transition: transform 0.2s ease; color: var(--text-muted);
}
.repo-run-card.expanded .expand-arrow { transform: rotate(180deg); }

/* ── Lightboxes ──────────────────────────────────────────────── */
.lightbox {
  position:fixed; inset:0; z-index:1000;
  background:rgba(0,0,0,0.85); backdrop-filter:blur(20px);
  display:none; align-items:center; justify-content:center;
  animation:fadeIn 0.3s ease;
}
.lightbox.show { display:flex; }
@keyframes fadeIn { from{opacity:0} to{opacity:1} }
.lightbox-content { max-width:900px; width:90%; border-radius:var(--radius-xl); overflow:hidden; box-shadow:0 20px 60px rgba(0,0,0,0.5); }
.lightbox-content video { width:100%; display:block; }
.lightbox-close { position:absolute; top:20px; right:20px; width:40px; height:40px; border-radius:50%; background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.15); color:#fff; font-size:20px; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:var(--transition); }
.lightbox-close:hover { background:rgba(255,255,255,0.2); }
.img-lightbox { position:fixed; inset:0; z-index:1001; background:rgba(0,0,0,0.9); backdrop-filter:blur(20px); display:none; align-items:center; justify-content:center; cursor:pointer; }
.img-lightbox.show { display:flex; }
.img-lightbox img { max-width:90vw; max-height:90vh; object-fit:contain; border-radius:var(--radius-lg); box-shadow:0 20px 60px rgba(0,0,0,0.5); }

/* ── Unit Detail Modal ──────────────────────────────────────── */
.unit-modal-backdrop {
  position:fixed; inset:0; z-index:1000;
  background:rgba(0,0,0,0.8); backdrop-filter:blur(12px);
  display:none; align-items:center; justify-content:center;
  animation:fadeIn 0.25s ease;
}
.unit-modal-backdrop.show { display:flex; }
.unit-modal {
  width:92vw; max-width:1100px; max-height:88vh;
  background:var(--bg-secondary); border:1px solid var(--border-subtle);
  border-radius:var(--radius-xl); overflow:hidden;
  display:flex; flex-direction:column;
  box-shadow:0 24px 80px rgba(0,0,0,0.6);
}
.unit-modal-header {
  display:flex; align-items:center; justify-content:space-between;
  padding:16px 24px; border-bottom:1px solid var(--border-subtle);
  background:var(--bg-card); flex-shrink:0;
}
.unit-modal-nav { display:flex; align-items:center; gap:8px; }
.unit-nav-btn {
  width:32px; height:32px; border-radius:8px; border:1px solid var(--border-subtle);
  background:transparent; color:var(--text-muted);
  cursor:pointer; transition:var(--transition);
  display:flex; align-items:center; justify-content:center; flex-shrink:0;
}
.unit-nav-btn:hover:not(:disabled) { background:rgba(255,255,255,0.06); color:var(--text-primary); border-color:var(--border-accent); }
.unit-nav-btn:disabled { opacity:0.25; cursor:default; }
.unit-modal-title { font-size:16px; font-weight:700; display:flex; align-items:center; gap:10px; }
.unit-modal-close {
  width:32px; height:32px; border-radius:8px; border:1px solid var(--border-subtle);
  background:transparent; color:var(--text-muted); font-size:18px;
  cursor:pointer; transition:var(--transition);
  display:flex; align-items:center; justify-content:center;
}
.unit-modal-close:hover { background:rgba(255,255,255,0.06); color:var(--text-primary); }
.unit-modal-body {
  display:flex; flex:1; overflow:hidden; min-height:0;
}
.unit-modal-left {
  flex:1; display:flex; flex-direction:column; background:#000;
  min-width:0;
}
.unit-modal-left video { width:100%; aspect-ratio:16/9; object-fit:contain; background:#000; flex-shrink:0; }
.unit-media-actions {
  display:flex;
  gap:8px;
  padding:12px 16px;
  background:linear-gradient(180deg, rgba(14,16,26,0.96), rgba(20,24,38,0.92));
  border-top:1px solid rgba(255,255,255,0.06);
  flex-wrap:wrap;
}
.unit-media-action-btn {
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:6px;
  min-height:34px;
  padding:7px 14px;
  border-radius:10px;
  border:1px solid var(--border-subtle);
  background:linear-gradient(180deg, rgba(255,255,255,0.045), rgba(255,255,255,0.02));
  color:var(--text-secondary);
  font-family:var(--font-sans);
  font-size:12px;
  cursor:pointer;
  transition:var(--transition);
}
.unit-media-action-btn:hover:not(:disabled) {
  border-color: var(--border-accent);
  color: var(--text-primary);
  transform: translateY(-1px);
}
.unit-media-action-btn:disabled {
  opacity:0.55;
  cursor:not-allowed;
}
.unit-media-action-btn.primary {
  border-color: rgba(99,102,241,0.34);
  color: #c7d2fe;
  background: linear-gradient(135deg, rgba(99,102,241,0.16), rgba(139,92,246,0.08));
}
.unit-media-action-hint {
  width:100%;
  font-size:11px;
  color:var(--text-muted);
  line-height:1.5;
}
.unit-media-action-menu {
  position: fixed;
  z-index: 1300;
  min-width: 180px;
  padding: 6px;
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,0.08);
  background: rgba(10,12,18,0.96);
  box-shadow: 0 18px 50px rgba(0,0,0,0.45);
  display: none;
}
.unit-media-action-menu.show {
  display: block;
}
.unit-media-action-item {
  width:100%;
  border:none;
  background:transparent;
  color:var(--text-secondary);
  text-align:left;
  font-family:var(--font-sans);
  font-size:12px;
  padding:10px 12px;
  border-radius:10px;
  cursor:pointer;
}
.unit-media-action-item:hover {
  background:rgba(255,255,255,0.06);
  color:var(--text-primary);
}
.unit-media-action-item small {
  display:block;
  margin-top:2px;
  color:var(--text-muted);
  font-size:10px;
}
.unit-modal-attempts-bar {
  display:flex; gap:6px; padding:12px 16px; background:var(--bg-card);
  border-top:1px solid var(--border-subtle); flex-shrink:0;
  align-items:center; flex-wrap:wrap;
}
.unit-attempt-toolbar {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  width:100%;
  flex-wrap:wrap;
}
.unit-attempt-toolbar-left {
  display:flex;
  align-items:center;
  gap:6px;
  flex-wrap:wrap;
  min-width:0;
}
.unit-attempt-toolbar-right {
  display:flex;
  align-items:center;
  gap:8px;
  flex-wrap:wrap;
  margin-left:auto;
}
.unit-attempt-toolbar-label {
  font-size:11px;
  color:var(--text-muted);
  font-weight:600;
  margin-right:4px;
}
.unit-modal-attempts-bar .attempt-dot { width:28px; height:28px; font-size:12px; border-radius:8px; }
.unit-modal-right {
  width:400px; min-width:340px; display:flex; flex-direction:column;
  border-left:1px solid var(--border-subtle);
  overflow:hidden;
}
.unit-modal-tabs {
  display:flex; border-bottom:1px solid var(--border-subtle);
  background:var(--bg-card); flex-shrink:0;
}
.unit-modal-tab {
  flex:1; padding:10px 12px; border:none; background:transparent;
  color:var(--text-muted); font-family:var(--font-sans); font-size:12px; font-weight:600;
  cursor:pointer; transition:var(--transition); text-align:center;
  border-bottom:2px solid transparent;
}
.unit-modal-tab:hover { color:var(--text-secondary); }
.unit-modal-tab.active { color:var(--accent); border-bottom-color:var(--accent); }
.unit-modal-panel {
  flex:1; overflow-y:auto; padding:16px;
  scrollbar-width:thin; scrollbar-color:rgba(255,255,255,0.08) transparent;
  display:none;
}
.unit-modal-panel::-webkit-scrollbar { width:5px; }
.unit-modal-panel::-webkit-scrollbar-thumb { background:rgba(255,255,255,0.1); border-radius:3px; }
.unit-modal-panel.active { display:block; }
.modal-section-label {
  font-size:10px; font-weight:700; color:var(--text-muted);
  text-transform:uppercase; letter-spacing:0.8px; margin-bottom:8px;
}
.modal-prompt-text {
  font-size:13px; line-height:1.8; color:var(--text-secondary);
  white-space:pre-wrap; word-break:break-word;
}
.modal-critique-block {
  background:var(--bg-glass); border:1px solid var(--border-subtle);
  border-radius:var(--radius); padding:12px; margin-bottom:12px;
}
.modal-critique-block .critique-score { margin-bottom:8px; }
.modal-critique-block .critique-items { padding-left:16px; font-size:11px; line-height:1.5; }
.modal-critique-block .critique-items li { margin-bottom:2px; }
.modal-critique-block .modal-section-label { font-size:11px; }
.modal-attempt-meta {
  font-size:11px; color:var(--text-muted); margin-top:12px;
  display:flex; flex-direction:column; gap:4px;
}
.modal-attempt-meta span { display:flex; align-items:center; gap:6px; }
.modal-attempt-meta strong { color:var(--text-secondary); font-weight:600; }

/* ══════════════════════════════════════════════════════════════
   TAB 3: Create
   ══════════════════════════════════════════════════════════════ */
#view-create { height: 100%; }
#view-create.active { display: flex; flex-direction: column; overflow-y: auto; }

.create-container { max-width: 1100px; width: 100%; margin: 0 auto; padding: 32px 28px; }

.create-hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 20px;
  padding: 28px;
  border-radius: 24px;
  border: 1px solid rgba(99,102,241,0.22);
  background:
    radial-gradient(circle at top left, rgba(99,102,241,0.22), transparent 34%),
    radial-gradient(circle at 85% 18%, rgba(236,72,153,0.18), transparent 28%),
    radial-gradient(circle at 70% 88%, rgba(6,182,212,0.14), transparent 24%),
    linear-gradient(135deg, rgba(12,14,24,0.96), rgba(16,19,31,0.92));
  box-shadow:
    0 18px 60px rgba(0,0,0,0.38),
    inset 0 1px 0 rgba(255,255,255,0.05),
    0 0 0 1px rgba(255,255,255,0.02);
}
.create-hero::before {
  content: '';
  position: absolute;
  inset: -1px;
  border-radius: inherit;
  padding: 1px;
  background: linear-gradient(135deg, rgba(99,102,241,0.45), rgba(236,72,153,0.2), rgba(6,182,212,0.3));
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  pointer-events: none;
}
.create-hero::after {
  content: '';
  position: absolute;
  width: 420px;
  height: 420px;
  right: -140px;
  top: -150px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(99,102,241,0.22) 0%, rgba(99,102,241,0.06) 35%, transparent 68%);
  filter: blur(6px);
  animation: heroFloat 10s ease-in-out infinite;
}
.create-hero-grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(0, 1.3fr) minmax(300px, 0.9fr);
  gap: 24px;
  align-items: stretch;
}
.create-hero-copy {
  position: relative;
  min-width: 0;
}
.create-hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 7px 14px;
  border-radius: 999px;
  border: 1px solid rgba(99,102,241,0.3);
  background: rgba(99,102,241,0.08);
  color: #c7d2fe;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  box-shadow: 0 0 22px rgba(99,102,241,0.12);
}
.create-hero-badge::before {
  content: '';
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), var(--cyan));
  box-shadow: 0 0 12px rgba(99,102,241,0.7);
  animation: pulse 2s ease-in-out infinite;
}
.create-hero-title {
  margin-top: 18px;
  font-size: clamp(30px, 5vw, 54px);
  line-height: 1.02;
  font-weight: 800;
  letter-spacing: -0.04em;
  max-width: none;
  white-space: nowrap;
}
.create-hero-title-main {
  display: block;
  color: var(--text-primary);
}
.create-hero-title-highlight {
  display: block;
  margin-top: 8px;
  background: linear-gradient(90deg, #ffffff 0%, #c4b5fd 32%, #7dd3fc 64%, #f9a8d4 100%);
  background-size: 200% 100%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: heroShine 7s linear infinite;
  text-shadow: 0 0 24px rgba(139,92,246,0.22);
}
.create-hero-subtitle {
  margin-top: 16px;
  max-width: 680px;
  font-size: 14px;
  line-height: 1.85;
  color: rgba(232,234,237,0.78);
}
.create-hero-actions {
  margin-top: 22px;
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}
.create-hero-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  min-height: 44px;
  padding: 0 18px;
  border-radius: 12px;
  border: 1px solid rgba(99,102,241,0.3);
  background: linear-gradient(135deg, rgba(99,102,241,0.2), rgba(139,92,246,0.14));
  color: #fff;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.02em;
  cursor: pointer;
  transition: var(--transition);
  box-shadow: 0 10px 30px rgba(99,102,241,0.16);
}
.create-hero-cta:hover {
  transform: translateY(-1px);
  border-color: rgba(99,102,241,0.5);
  box-shadow: 0 14px 34px rgba(99,102,241,0.24);
}
.create-hero-note {
  font-size: 12px;
  color: var(--text-secondary);
}
.create-hero-features {
  margin-top: 22px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}
.create-hero-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 9px 12px;
  border-radius: 12px;
  background: rgba(255,255,255,0.045);
  border: 1px solid rgba(255,255,255,0.08);
  color: var(--text-secondary);
  font-size: 12px;
  font-weight: 600;
  backdrop-filter: blur(10px);
}
.create-hero-chip::before {
  content: '';
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--accent), var(--cyan));
  box-shadow: 0 0 10px rgba(99,102,241,0.5);
}
.create-hero-visual {
  position: relative;
  min-height: 320px;
  border-radius: 20px;
  background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.015));
  border: 1px solid rgba(255,255,255,0.06);
  backdrop-filter: blur(18px);
  padding: 18px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
}
.create-hero-orbit {
  position: absolute;
  inset: 18px;
  border-radius: 18px;
  border: 1px solid rgba(255,255,255,0.05);
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}
.create-hero-orbit::before,
.create-hero-orbit::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  inset: 22px;
  border: 1px solid rgba(99,102,241,0.12);
  animation: spin 14s linear infinite;
}
.create-hero-orbit::after {
  inset: 52px;
  border-color: rgba(6,182,212,0.12);
  animation-direction: reverse;
  animation-duration: 18s;
}
.create-hero-node {
  position: absolute;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  opacity: 0.78;
  transform: translate(-50%, -50%);
  background: linear-gradient(135deg, #fff, #a5b4fc);
  box-shadow: 0 0 16px rgba(129,140,248,0.36);
}
.create-hero-node.node-a { top: 17%; left: 18%; }
.create-hero-node.node-b { top: 22%; left: 84%; background: linear-gradient(135deg, #7dd3fc, #67e8f9); }
.create-hero-node.node-c { top: 75%; left: 22%; background: linear-gradient(135deg, #f9a8d4, #f472b6); }
.create-hero-node.node-d { top: 80%; left: 80%; background: linear-gradient(135deg, #c4b5fd, #818cf8); }
.create-hero-panel {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}
.create-hero-card {
  position: relative;
  overflow: hidden;
  min-height: 116px;
  border-radius: 16px;
  padding: 14px 15px;
  background: rgba(8,9,13,0.44);
  border: 1px solid rgba(255,255,255,0.07);
  box-shadow: 0 10px 30px rgba(0,0,0,0.18);
}
.create-hero-card::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
  transform: translateX(-120%);
  animation: heroSweep 6s ease-in-out infinite;
}
.create-hero-card-label {
  font-size: 10px;
  font-weight: 700;
  color: var(--text-muted);
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.create-hero-card-value {
  margin-top: 8px;
  font-size: 18px;
  font-weight: 700;
  color: var(--text-primary);
}
.create-hero-card-sub {
  margin-top: 6px;
  font-size: 12px;
  line-height: 1.6;
  color: var(--text-secondary);
}
@keyframes heroFloat {
  0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
  50% { transform: translate3d(-18px, 24px, 0) scale(1.05); }
}
@keyframes heroShine {
  0% { background-position: 0% 50%; }
  100% { background-position: 200% 50%; }
}
@keyframes heroSweep {
  0%, 65% { transform: translateX(-120%); }
  100% { transform: translateX(130%); }
}

/* Phase A: Mode selection */
.create-mode-cards { display: flex; gap: 16px; margin-bottom: 32px; }
.mode-card {
  flex: 1; padding: 28px 24px; border-radius: var(--radius-lg);
  border: 2px solid var(--border-subtle); background: var(--bg-card);
  cursor: pointer; transition: var(--transition); text-align: center;
  display: flex; flex-direction: column; align-items: center; gap: 12px;
}
.mode-card:hover { border-color: var(--border-accent); background: var(--bg-card-hover); transform: translateY(-2px); }
.mode-card.selected { border-color: var(--accent); background: rgba(99,102,241,0.08); box-shadow: 0 0 24px var(--accent-glow); }
.mode-card-icon {
  width: 56px; height: 56px; border-radius: 16px;
  display: flex; align-items: center; justify-content: center;
  font-size: 24px;
  background: linear-gradient(135deg, rgba(99,102,241,0.12), rgba(139,92,246,0.08));
  border: 1px solid rgba(99,102,241,0.2);
  transition: var(--transition);
}
.mode-card.selected .mode-card-icon {
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  border-color: transparent;
}
.mode-card-title { font-size: 16px; font-weight: 700; }
.mode-card-desc { font-size: 12px; color: var(--text-muted); line-height: 1.6; }

/* Form fields */
.create-form { display: flex; flex-direction: column; gap: 20px; }
.form-row { display: flex; gap: 16px; }
.form-row > * { flex: 1; }
.form-group { display: flex; flex-direction: column; gap: 6px; }
.form-label { font-size: 12px; font-weight: 600; color: var(--text-secondary); text-transform: uppercase; letter-spacing: 0.5px; }
.form-input, .form-select, .form-textarea {
  padding: 10px 14px; border-radius: var(--radius);
  border: 1px solid var(--border-subtle); background: var(--bg-glass);
  color: var(--text-primary); font-family: var(--font-sans); font-size: 13px;
  transition: var(--transition); outline: none;
}
.form-input:focus, .form-select:focus, .form-textarea:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); }
.form-select { cursor: pointer; appearance: auto; }
.form-textarea { resize: vertical; min-height: 100px; line-height: 1.7; }
.form-input::placeholder, .form-textarea::placeholder { color: var(--text-muted); }
input[type="number"]::-webkit-outer-spin-button,
input[type="number"]::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}
input[type="number"] {
  appearance: textfield;
  -moz-appearance: textfield;
}
.form-help { font-size: 11px; color: var(--text-muted); }

.mode-fields { display: none; }
.mode-fields.active { display: flex; flex-direction: column; gap: 20px; }

.create-submit-row {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  margin-top: 8px;
  flex-wrap: wrap;
}
.create-submit-action {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 260px;
  flex: 1 1 280px;
  max-width: 420px;
}
.create-submit-action > .btn-primary,
.create-submit-action > .btn-secondary {
  width: 100%;
  min-height: 46px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.create-submit-hint {
  font-size: 12px;
  line-height: 1.65;
  color: var(--text-muted);
}
.create-submit-action.one-click .create-submit-hint {
  color: rgba(255, 229, 192, 0.78);
}
.create-submit-row #create-submit-status {
  flex-basis: 100%;
}

/* Proxy mode */
.proxy-mode-row {
  display: flex; align-items: center; gap: 10px; margin-top: 12px;
  padding: 8px 14px; border-radius: var(--radius);
  background: var(--bg-glass); border: 1px solid var(--border-subtle);
  transition: var(--transition);
}
.proxy-mode-row.active { border-color: var(--accent); background: rgba(99,102,241,0.06); }
.proxy-mode-row label {
  display: flex; align-items: center; gap: 7px; cursor: pointer;
  font-size: 13px; color: var(--text-secondary); user-select: none; white-space: nowrap;
}
.proxy-mode-row input[type="checkbox"] {
  accent-color: var(--accent); width: 14px; height: 14px; cursor: pointer; margin: 0;
}
.proxy-mode-row .proxy-hint { font-size: 11px; color: var(--text-muted); }
.proxy-mode-row .proxy-cookie-summary {
  font-size: 12px; color: var(--cyan); cursor: pointer; font-family: var(--font-mono);
  padding: 3px 8px; border-radius: 6px; background: rgba(34,211,238,0.08);
  border: 1px solid rgba(34,211,238,0.15); transition: var(--transition);
}
.proxy-mode-row .proxy-cookie-summary:hover { background: rgba(34,211,238,0.14); border-color: rgba(34,211,238,0.3); }
.proxy-cookie-modal-backdrop {
  position: fixed; inset: 0; z-index: 10040;
  background: rgba(0,0,0,0.7); backdrop-filter: blur(12px);
  display: none; align-items: center; justify-content: center;
  animation: fadeIn 0.2s ease;
}
.proxy-cookie-modal-backdrop.show { display: flex; }
.proxy-cookie-modal {
  width: 480px; max-width: 90vw; background: var(--bg-secondary);
  border: 1px solid var(--border-subtle); border-radius: var(--radius-lg);
  padding: 24px 28px; box-shadow: 0 20px 60px rgba(0,0,0,0.5);
}
.proxy-cookie-modal h3 {
  font-size: 15px; font-weight: 600; color: var(--text-primary); margin-bottom: 4px;
  display: flex; align-items: center; gap: 8px;
}
.proxy-cookie-modal h3::before { content: '🔑'; font-size: 16px; }
.proxy-cookie-modal p { font-size: 12px; color: var(--text-muted); margin-bottom: 14px; line-height: 1.5; }
.proxy-cookie-modal input[type="text"] {
  width: 100%; padding: 10px 14px; border-radius: var(--radius);
  border: 1px solid var(--border-subtle); background: var(--bg-glass);
  color: var(--text-primary); font-family: var(--font-mono); font-size: 13px;
  outline: none; transition: var(--transition);
}
.proxy-cookie-modal input[type="text"]:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); }
.proxy-cookie-modal-actions { display: flex; gap: 10px; margin-top: 14px; justify-content: flex-end; }
.proxy-cookie-modal-actions .btn-primary { padding: 8px 20px; font-size: 13px; }
.proxy-cookie-modal-actions .btn-secondary { padding: 8px 16px; font-size: 13px; }
.editor-proxy-toggle {
  display: flex; align-items: center; gap: 6px;
  padding: 4px 10px; border-radius: 8px;
  border: 1px solid var(--border-subtle); background: rgba(255,255,255,0.02);
  transition: border-color 0.15s, background 0.15s;
}
.editor-proxy-toggle.active { border-color: var(--accent); background: rgba(99,102,241,0.06); }
.editor-proxy-session-badge {
  font-size: 11px; color: var(--cyan); cursor: pointer;
  padding: 2px 8px; border-radius: 6px;
  background: rgba(34,211,238,0.08); border: 1px solid rgba(34,211,238,0.15);
  white-space: nowrap;
}
.editor-proxy-session-badge:hover { background: rgba(34,211,238,0.14); border-color: rgba(34,211,238,0.3); }
.create-divider { height: 1px; background: var(--border-subtle); margin: 28px 0; }
.btn-primary {
  padding: 12px 32px; border-radius: var(--radius); border: none;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: #fff; font-family: var(--font-sans); font-size: 14px; font-weight: 600;
  cursor: pointer; transition: var(--transition); letter-spacing: 0.3px;
  box-shadow: 0 4px 16px var(--accent-glow);
}
.btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 24px var(--accent-glow); }
.btn-primary:disabled { opacity: 0.5; cursor: default; transform: none; }
.backend-select {
  padding: 10px 14px; border-radius: var(--radius);
  border: 1px solid var(--border-subtle); background: var(--bg-glass);
  color: var(--text-primary); font-family: var(--font-sans); font-size: 13px; font-weight: 500;
  cursor: pointer; transition: var(--transition); appearance: auto;
}
.backend-select:hover { border-color: var(--accent); }
.backend-select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-glow); }
.btn-secondary {
  padding: 10px 24px; border-radius: var(--radius);
  border: 1px solid var(--border-subtle); background: var(--bg-glass);
  color: var(--text-secondary); font-family: var(--font-sans); font-size: 13px; font-weight: 500;
  cursor: pointer; transition: var(--transition);
}
.btn-secondary:hover { border-color: var(--border-accent); color: var(--text-primary); }
.btn-one-click {
  border: 1px solid rgba(251, 191, 36, 0.42);
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.96), rgba(249, 115, 22, 0.92));
  color: #1f1303;
  font-weight: 700;
  box-shadow: 0 10px 28px rgba(249, 115, 22, 0.24);
}
.btn-one-click:hover:not(:disabled) {
  border-color: rgba(253, 224, 71, 0.72);
  color: #120b02;
  transform: translateY(-1px);
  box-shadow: 0 14px 34px rgba(249, 115, 22, 0.34);
}
.btn-one-click:disabled {
  opacity: 0.45;
  cursor: default;
  transform: none;
  box-shadow: none;
}

/* File upload */
.file-upload-zone {
  border: 2px dashed var(--border-subtle); border-radius: var(--radius);
  padding: 24px; text-align: center; cursor: pointer;
  transition: var(--transition); color: var(--text-muted); font-size: 13px;
}
.file-upload-zone:hover { border-color: var(--border-accent); background: rgba(99,102,241,0.03); }
.file-upload-zone.has-file { border-color: var(--success); border-style: solid; background: var(--success-glow); color: var(--text-primary); }
.file-upload-zone.drag-over { border-color: var(--border-accent); border-style: solid; background: rgba(99,102,241,0.08); color: var(--text-primary); transform: scale(1.01); }
.file-upload-zone input[type="file"] { display: none; }

/* Phase B: Pipeline */
.create-pipeline { display: none; }
.create-pipeline.active { display: flex; gap: 32px; min-height: 480px; }

.pipeline-stepper {
  width: 240px; min-width: 240px; display: flex; flex-direction: column; gap: 0;
}
.step-item {
  display: flex; gap: 14px; padding: 14px 0; position: relative;
}
.step-item:not(:last-child)::after {
  content: ''; position: absolute;
  left: 17px; top: 48px; bottom: -4px; width: 2px;
  background: var(--border-subtle);
}
.step-item.completed:not(:last-child)::after { background: var(--success); }
.step-item.active:not(:last-child)::after {
  background: linear-gradient(180deg, var(--accent) 50%, var(--border-subtle) 50%);
  animation: stepPulse 1.5s ease-in-out infinite;
}
@keyframes stepPulse { 0%,100% { opacity:1; } 50% { opacity:0.5; } }
.step-icon {
  width: 36px; height: 36px; border-radius: 10px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 14px; font-weight: 700; border: 2px solid var(--border-subtle);
  background: var(--bg-glass); color: var(--text-muted); transition: var(--transition);
  z-index: 1;
}
.step-item.completed .step-icon { background: var(--success); border-color: var(--success); color: #fff; }
.step-item.completed { cursor: pointer; }
.step-item.completed:hover .step-icon { opacity: 0.85; transform: scale(1.05); transition: var(--transition); }
.step-item.completed * { pointer-events: none; }
.step-item.active .step-icon {
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  border-color: var(--accent); color: #fff;
  box-shadow: 0 0 16px var(--accent-glow);
  animation: stepPulse 1.5s ease-in-out infinite;
}
.step-item.error .step-icon { background: var(--error); border-color: var(--error); color: #fff; }
.step-info { flex: 1; min-width: 0; }
.step-title { font-size: 13px; font-weight: 600; color: var(--text-secondary); }
.step-item.active .step-title { color: var(--text-primary); }
.step-item.completed .step-title { color: var(--success); }
.step-item.error .step-title { color: var(--error); }
.step-desc { font-size: 11px; color: var(--text-muted); margin-top: 2px; }

.pipeline-content {
  flex: 1; background: var(--bg-card); border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg); padding: 24px; overflow-y: auto;
  max-height: 600px;
}
.pipeline-content-title { font-size: 15px; font-weight: 700; margin-bottom: 16px; color: var(--text-primary); }
.pipeline-waiting { color: var(--text-muted); font-size: 14px; display: flex; align-items: center; gap: 10px; }
.pipeline-waiting .live-dot { width: 8px; height: 8px; }

/* Pipeline artifacts */
.artifact-section { margin-bottom: 20px; }
.artifact-label { font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 8px; }

.issue-card {
  padding: 10px 14px; border-radius: 8px; margin-bottom: 6px;
  border-left: 3px solid var(--text-muted);
  background: var(--bg-glass); font-size: 12px; line-height: 1.6;
  color: var(--text-secondary);
}
.issue-card.critical { border-left-color: var(--error); }
.issue-card.warning { border-left-color: var(--warning); }
.issue-card.info { border-left-color: var(--cyan); }
.issue-card .issue-title { font-weight: 600; color: var(--text-primary); margin-bottom: 2px; }
.issue-card .issue-scenes { font-size: 10px; color: var(--text-muted); font-family: var(--font-mono); }

.patch-card {
  padding: 10px 14px; border-radius: 8px; margin-bottom: 6px;
  background: var(--bg-glass); border: 1px solid var(--border-subtle);
  font-size: 12px; line-height: 1.6;
}

/* Segment Preview Modal */
.segment-modal-overlay {
  position: fixed; inset: 0; z-index: 10000;
  background: rgba(0,0,0,0.85); backdrop-filter: blur(8px);
  display: none; align-items: center; justify-content: center;
}
.segment-modal-overlay.show { display: flex; }
.segment-modal {
  background: var(--bg-secondary); border: 1px solid var(--border-subtle);
  border-radius: var(--radius-xl); width: 90vw; max-width: 900px;
  max-height: 85vh; display: flex; flex-direction: column;
  box-shadow: 0 24px 80px rgba(0,0,0,0.6);
}
.segment-modal-header {
  padding: 20px 24px; border-bottom: 1px solid var(--border-subtle);
  display: flex; align-items: center; justify-content: space-between;
  flex-shrink: 0;
}
.segment-modal-title { font-size: 16px; font-weight: 700; }
.segment-modal-nav { display: flex; gap: 8px; }
.segment-nav-btn {
  width: 36px; height: 36px; border-radius: 8px;
  border: 1px solid var(--border-subtle); background: var(--bg-card);
  color: var(--text-secondary); cursor: pointer; transition: var(--transition);
  display: flex; align-items: center; justify-content: center;
}
.segment-nav-btn:hover:not(:disabled) { border-color: var(--border-accent); color: var(--text-primary); background: var(--bg-card-hover); }
.segment-nav-btn:disabled { opacity: 0.3; cursor: not-allowed; }
.segment-modal-close {
  width: 36px; height: 36px; border-radius: 8px;
  border: 1px solid var(--border-subtle); background: transparent;
  color: var(--text-muted); cursor: pointer; transition: var(--transition);
  display: flex; align-items: center; justify-content: center; font-size: 20px;
}
.segment-modal-close:hover { border-color: var(--error); color: var(--error); background: var(--error-glow); }
.segment-modal-body {
  flex: 1; overflow-y: auto; padding: 24px;
}
.segment-narrative {
  background: var(--bg-card); border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg); padding: 16px 20px; margin-bottom: 20px;
  line-height: 1.8; color: var(--text-secondary); font-size: 14px;
}
.segment-scenes-title {
  font-size: 13px; font-weight: 700; color: var(--text-muted);
  text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 12px;
}
.segment-scene-card {
  background: var(--bg-card); border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg); padding: 16px 18px; margin-bottom: 12px;
  transition: var(--transition);
}
.segment-scene-card:hover { border-color: var(--border-accent); }
.segment-scene-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 10px; padding-bottom: 10px; border-bottom: 1px solid var(--border-subtle);
}
.segment-scene-num {
  font-size: 12px; font-weight: 700; color: var(--accent);
  background: rgba(99,102,241,0.12); padding: 4px 10px; border-radius: 6px;
}
.segment-scene-dur { font-size: 11px; color: var(--text-muted); font-family: var(--font-mono); }
.segment-scene-summary {
  font-size: 13px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 8px;
}
.segment-scene-meta { display: flex; gap: 8px; flex-wrap: wrap; }

/* Screenplay Review Chat */
.screenplay-chat-container {
  margin-top: 20px; border-top: 1px solid var(--border-subtle); padding-top: 20px;
}
.chat-messages {
  max-height: 300px; overflow-y: auto; margin-bottom: 16px;
  display: flex; flex-direction: column; gap: 12px;
}
.chat-message {
  display: flex; gap: 12px; align-items: flex-start;
}
.chat-message.user { flex-direction: row-reverse; }
.chat-avatar {
  width: 32px; height: 32px; border-radius: 8px; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; font-weight: 600;
}
.chat-avatar.user { background: linear-gradient(135deg, var(--accent), var(--accent-2)); color: #fff; }
.chat-avatar.assistant { background: var(--bg-card); border: 1px solid var(--border-subtle); color: var(--text-muted); }
.chat-bubble {
  max-width: 70%; padding: 10px 14px; border-radius: 12px;
  font-size: 13px; line-height: 1.6;
}
.chat-bubble.user { background: rgba(99,102,241,0.15); color: var(--text-primary); border-radius: 12px 12px 0 12px; }
.chat-bubble.assistant { background: var(--bg-card); border: 1px solid var(--border-subtle); color: var(--text-secondary); border-radius: 12px 12px 12px 0; }
.chat-input-row {
  display: flex; gap: 8px; align-items: flex-end;
}
.chat-input {
  flex: 1; padding: 10px 14px; border-radius: 8px;
  border: 1px solid var(--border-subtle); background: var(--bg-card);
  color: var(--text-primary); font-size: 13px; font-family: var(--font-sans);
  resize: vertical; min-height: 40px; max-height: 120px;
}
.chat-input:focus { outline: none; border-color: var(--border-accent); }
.chat-send-btn {
  padding: 10px 18px; border-radius: 8px; border: none;
  background: var(--accent); color: #fff; font-size: 13px; font-weight: 600;
  cursor: pointer; transition: var(--transition); white-space: nowrap;
}
.chat-send-btn:hover { background: var(--accent-2); }
.chat-send-btn:disabled { opacity: 0.5; cursor: not-allowed; }
.patch-card .patch-scene { font-weight: 600; color: var(--accent); font-family: var(--font-mono); font-size: 11px; }
.patch-card .patch-changes { color: var(--text-secondary); margin-top: 4px; }

.screenplay-preview {
  font-size: 12px; line-height: 1.8; color: var(--text-secondary);
  max-height: 400px; overflow-y: auto; padding: 12px;
  background: rgba(0,0,0,0.2); border-radius: 8px;
  scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.08) transparent;
}
.screenplay-char { color: var(--cyan); font-weight: 600; }
.screenplay-scene { color: var(--accent); font-weight: 600; }

/* Phase C: Editor */
.create-editor { display: none; }
.create-editor.active { display: flex; gap: 0; min-height: 500px; border: 1px solid var(--border-subtle); border-radius: var(--radius-lg); overflow: hidden; }

.editor-sidebar {
  width: 340px; min-width: 300px; background: var(--bg-secondary);
  border-right: 1px solid var(--border-subtle);
  display: flex; flex-direction: column; overflow-y: auto;
  max-height: 600px;
}
.editor-sidebar-section { padding: 16px; border-bottom: 1px solid var(--border-subtle); }
.editor-sidebar-head { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-bottom:12px; }
.editor-sidebar-title { font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.8px; margin-bottom: 0; }
.editor-add-btn {
  padding: 4px 8px; border-radius: 999px; border: 1px solid var(--border-accent);
  background: rgba(99,102,241,0.08); color: var(--accent); cursor: pointer;
  font-size: 11px; font-weight: 700; transition: var(--transition); white-space: nowrap;
}
.editor-add-btn:hover { background: rgba(99,102,241,0.16); }
.editor-empty { color: var(--text-muted); font-size: 12px; padding: 6px 2px; }

.editor-entity {
  display: flex; align-items: center; gap: 12px; padding: 10px 12px;
  border-radius: var(--radius); margin-bottom: 6px;
  border: 1px solid var(--border-subtle); background: var(--bg-glass);
  transition: var(--transition);
}
.editor-entity:hover { border-color: var(--border-accent); }
.editor-entity-img {
  width: 48px; height: 48px; border-radius: 10px; object-fit: cover;
  border: 1px solid var(--border-subtle); flex-shrink: 0; cursor: pointer;
  background: rgba(99,102,241,0.08);
}
.editor-entity-placeholder {
  width: 48px; height: 48px; border-radius: 10px; flex-shrink: 0;
  background: rgba(99,102,241,0.08); border: 1px dashed var(--border-accent);
  display: flex; align-items: center; justify-content: center;
  color: var(--accent); font-size: 18px; cursor: pointer;
}
.editor-entity-info { flex: 1; min-width: 0; }
.editor-entity-name { font-size: 13px; font-weight: 600; }
.editor-entity-desc { font-size: 11px; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.editor-entity-actions { display: flex; gap: 4px; flex-shrink: 0; flex-wrap: wrap; justify-content: flex-end; }
.editor-chip-list { display:flex; flex-wrap:wrap; gap:6px; margin-top:12px; }
.editor-chip {
  display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:999px;
  border:1px solid var(--border-subtle); background: rgba(255,255,255,0.04);
  font-size:11px; color: var(--text-secondary);
}
.editor-chip button {
  background:none; border:none; color: var(--text-muted); cursor:pointer; font-size:12px; padding:0;
}
.editor-chip button:hover { color: var(--error); }
.editor-inline-help { font-size:11px; color: var(--text-muted); line-height:1.6; margin-top:10px; }
.editor-danger-btn { border-color: rgba(239,68,68,0.35); color: #fca5a5; }
.editor-danger-btn:hover { background: rgba(239,68,68,0.1); }
.editor-upload-btn {
  padding: 4px 8px; border-radius: 6px; font-size: 10px; font-weight: 600;
  border: 1px solid var(--border-accent); background: transparent;
  color: var(--accent); cursor: pointer; transition: var(--transition);
  white-space: nowrap;
}
.editor-upload-btn:hover { background: rgba(99,102,241,0.1); }
.editor-lib-btn { border-color: rgba(236,72,153,0.3); color: var(--pink); }
.editor-lib-btn:hover { background: rgba(236,72,153,0.1); }

.editor-main {
  flex: 1; overflow-y: auto; padding: 0; display: flex; flex-direction: column;
  max-height: 600px;
}
.editor-main-header {
  padding: 16px 24px; background: var(--bg-card);
  border-bottom: 1px solid var(--border-subtle); flex-shrink: 0;
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
}
.editor-main-title { font-size: 16px; font-weight: 700; }
.editor-header-main {
  display: flex; align-items: center; gap: 12px; min-width: 0; flex: 1;
}
.editor-title-input {
  font-size: 16px; font-weight: 700; color: var(--text-primary);
  background: transparent; border: none; outline: none;
  padding: 4px 8px; border-radius: 6px;
  transition: var(--transition);
  font-family: inherit; min-width: 0; flex: 1;
}
.editor-title-input:hover {
  background: rgba(255,255,255,0.03);
}
.editor-title-input:focus {
  background: var(--bg-card);
  border: 1px solid var(--border-accent);
  padding: 3px 7px;
}
.editor-duration-box {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 7px 12px; border-radius: 999px;
  border: 1px solid rgba(99,102,241,0.16);
  background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.025));
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.05), 0 8px 24px rgba(0,0,0,0.18);
  flex-shrink: 0;
  transition: var(--transition);
}
.editor-duration-box:hover {
  border-color: rgba(99,102,241,0.28);
  background: linear-gradient(180deg, rgba(99,102,241,0.08), rgba(255,255,255,0.03));
}
.editor-duration-label {
  font-size: 11px; color: var(--text-muted); white-space: nowrap;
  text-transform: uppercase; letter-spacing: 0.5px; font-weight: 700;
}
.editor-duration-input,
.scene-duration-input {
  width: 84px;
  padding: 6px 12px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,0.08);
  background: rgba(8,9,13,0.72);
  color: var(--text-primary);
  font-size: 13px;
  font-family: var(--font-mono);
  text-align: center;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
  transition: var(--transition);
}
.editor-duration-input:hover,
.scene-duration-input:hover {
  border-color: rgba(255,255,255,0.14);
  background: rgba(8,9,13,0.9);
}
.editor-duration-input:focus,
.scene-duration-input:focus {
  outline: none;
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--accent-glow);
}
.scene-duration-field {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 8px 6px 0;
}
.scene-duration-suffix {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 30px;
  height: 30px;
  padding: 0 10px;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,0.08);
  background: rgba(255,255,255,0.04);
  color: var(--text-muted);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.4px;
}
.editor-scene-list { flex: 1; overflow-y: auto; padding: 16px 24px; }

.editor-scene {
  display: grid; grid-template-columns: 60px 1fr; gap: 12px;
  padding: 12px 14px; border-radius: var(--radius);
  border: 1px solid var(--border-subtle); background: var(--bg-glass);
  margin-bottom: 8px; transition: var(--transition); font-size: 12px;
  cursor: pointer;
}
.editor-scene:hover { border-color: var(--border-accent); background: var(--bg-card-hover); }
.editor-scene-num {
  font-family: var(--font-mono); font-weight: 700; font-size: 13px;
  color: var(--accent); padding-top: 2px;
}
.editor-scene-body { display: flex; flex-direction: column; gap: 4px; }
.editor-scene-plot { color: var(--text-secondary); line-height: 1.6; }
.editor-scene-meta { display: flex; flex-wrap: wrap; gap: 4px; }
.editor-scene-dur { font-family: var(--font-mono); color: var(--text-muted); font-size: 11px; }

.editor-actions {
  padding: 16px 24px; border-top: 1px solid var(--border-subtle);
  background: var(--bg-card); display: flex; gap: 12px; align-items: center;
  flex-shrink: 0;
}

/* Hidden file input for image upload */
.hidden-upload { display: none; }

/* Pipeline done message */
.pipeline-done-msg {
  padding: 20px; border-radius: var(--radius);
  background: var(--success-glow); border: 1px solid rgba(16,185,129,0.3);
  color: var(--success); font-size: 14px; font-weight: 600;
  display: flex; align-items: center; gap: 12px; margin-bottom: 16px;
}
.pipeline-done-msg svg { flex-shrink: 0; }

.create-back-row { margin-bottom: 20px; }

/* ── Quick Chat Bar ─────────────────────────────────────────── */
.quick-chat-wrap {
  margin: 0 0 32px;
  padding: 28px 32px 24px;
  border-radius: 20px;
  border: 1px solid rgba(99,102,241,0.28);
  background:
    radial-gradient(ellipse 60% 80% at 0% 50%, rgba(99,102,241,0.10) 0%, transparent 60%),
    radial-gradient(ellipse 40% 60% at 100% 30%, rgba(139,92,246,0.08) 0%, transparent 60%),
    linear-gradient(135deg, rgba(12,14,24,0.97), rgba(16,19,31,0.94));
  box-shadow: 0 8px 40px rgba(0,0,0,0.32), inset 0 1px 0 rgba(255,255,255,0.04);
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.quick-chat-header {
  display: flex;
  align-items: center;
  gap: 10px;
}
.quick-chat-icon {
  width: 32px; height: 32px;
  border-radius: 9px;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 0 14px rgba(99,102,241,0.35);
}
.quick-chat-icon svg { width: 16px; height: 16px; color: #fff; }
.quick-chat-title {
  font-size: 15px;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.2px;
}
.quick-chat-subtitle {
  font-size: 12px;
  color: var(--text-muted);
  margin-left: auto;
}
.quick-chat-box {
  width: 100%;
  background: rgba(8,9,13,0.7);
  border: 1.5px solid rgba(99,102,241,0.22);
  border-radius: 14px;
  padding: 14px 16px;
  display: flex;
  align-items: flex-end;
  gap: 12px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.25);
  transition: border-color var(--transition), box-shadow var(--transition);
}
.quick-chat-box:focus-within {
  border-color: rgba(99,102,241,0.6);
  box-shadow: 0 0 0 3px rgba(99,102,241,0.10), 0 2px 12px rgba(0,0,0,0.25);
}
.quick-chat-textarea {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  resize: none;
  font-family: var(--font-sans);
  font-size: 14px;
  color: var(--text-primary);
  line-height: 1.6;
  min-height: 24px;
  max-height: 160px;
  overflow-y: auto;
  scrollbar-width: thin;
}
.quick-chat-textarea::placeholder { color: var(--text-muted); }
.quick-chat-send {
  flex-shrink: 0;
  width: 38px; height: 38px;
  border-radius: 10px;
  border: none;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: #fff;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  transition: opacity var(--transition), transform var(--transition);
  box-shadow: 0 2px 8px rgba(99,102,241,0.35);
}
.quick-chat-send:hover { opacity: 0.88; transform: scale(1.05); }
.quick-chat-send:disabled { opacity: 0.35; cursor: not-allowed; transform: none; }
.quick-chat-send svg { width: 18px; height: 18px; }
.quick-chat-hints {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.quick-chat-hint-chip {
  font-size: 12px;
  color: var(--text-muted);
  background: rgba(255,255,255,0.04);
  border: 1px solid var(--border-subtle);
  border-radius: 20px;
  padding: 4px 12px;
  cursor: pointer;
  transition: color var(--transition), border-color var(--transition), background var(--transition);
  white-space: nowrap;
}
.quick-chat-hint-chip:hover {
  color: var(--text-secondary);
  border-color: rgba(99,102,241,0.3);
  background: rgba(99,102,241,0.06);
}
.create-active-banner {
  display: none;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  margin-bottom: 20px;
  padding: 14px 16px;
  border-radius: var(--radius);
  border: 1px solid rgba(99,102,241,0.22);
  background: linear-gradient(135deg, rgba(99,102,241,0.12), rgba(139,92,246,0.08));
}
.create-active-banner.show { display: flex; }
.create-active-banner-meta { min-width: 0; }
.create-active-banner-title { font-size: 13px; font-weight: 700; color: var(--text-primary); }
.create-active-banner-desc { margin-top: 4px; font-size: 12px; color: var(--text-secondary); }
.create-active-banner-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.btn-danger-soft {
  padding: 10px 24px; border-radius: var(--radius);
  border: 1px solid rgba(239,68,68,0.32); background: rgba(239,68,68,0.10);
  color: #fecaca; font-family: var(--font-sans); font-size: 13px; font-weight: 600;
  cursor: pointer; transition: var(--transition);
}
.btn-danger-soft:hover { border-color: rgba(239,68,68,0.55); background: rgba(239,68,68,0.16); color: #fff; }

/* ══════════════════════════════════════════════════════════════
   TAB 4: Assets Library
   ══════════════════════════════════════════════════════════════ */
#view-assets { height: 100%; }
#view-assets.active { display: flex; flex-direction: column; overflow: hidden; }

.assets-header {
  padding: 20px 28px 16px; border-bottom: 1px solid var(--border-subtle);
  background: var(--bg-secondary); flex-shrink: 0;
}
.assets-header-top {
  display: flex; align-items: center; justify-content: space-between;
  gap: 12px; margin-bottom: 12px; flex-wrap: wrap;
}
.assets-title { font-size: 20px; font-weight: 700; margin-bottom: 0; }
.assets-toolbar { display: flex; align-items: center; gap: 10px; }
.assets-upload-btn:disabled {
  opacity: 0.45; cursor: not-allowed; transform: none; box-shadow: none;
}
.assets-tabs { display: flex; gap: 2px; background: rgba(255,255,255,0.03); border-radius: 10px; padding: 3px; width: fit-content; }
.assets-tab {
  padding: 7px 18px; border-radius: 8px; border: none;
  background: transparent; color: var(--text-muted);
  font-family: var(--font-sans); font-size: 13px; font-weight: 500;
  cursor: pointer; transition: var(--transition);
  display: flex; align-items: center; gap: 6px;
}
.assets-tab:hover { color: var(--text-secondary); background: rgba(255,255,255,0.04); }
.assets-tab.active { color: var(--text-primary); background: rgba(99,102,241,0.15); }
.assets-tab-count { font-size: 10px; font-family: var(--font-mono); font-weight: 600; color: var(--accent); }

.assets-body { flex: 1; overflow-y: auto; padding: 24px 28px; }

.assets-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  gap: 14px;
}
.asset-lib-card {
  border-radius: var(--radius-lg); overflow: hidden;
  border: 1px solid var(--border-subtle); background: var(--bg-card);
  transition: var(--transition); cursor: pointer;
}
.asset-lib-card:hover { border-color: var(--border-accent); transform: translateY(-2px); box-shadow: var(--shadow-lg); }
.asset-lib-card img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; }
.asset-lib-card-info { padding: 10px 12px; }
.asset-lib-card-name { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.asset-lib-card-meta { font-size: 10px; color: var(--text-muted); margin-top: 3px; display: flex; gap: 8px; }
.asset-lib-card-actions { display: flex; gap: 6px; margin-top: 8px; }

/* Voice card */
.voice-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
.voice-card {
  display: flex; align-items: center; gap: 12px;
  padding: 14px 16px; border-radius: var(--radius);
  border: 1px solid var(--border-subtle); background: var(--bg-card);
  transition: var(--transition);
}
.voice-card:hover { border-color: var(--border-accent); }
.voice-icon {
  width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0;
  background: linear-gradient(135deg, rgba(236,72,153,0.12), rgba(139,92,246,0.08));
  border: 1px solid rgba(236,72,153,0.2);
  display: flex; align-items: center; justify-content: center; font-size: 16px;
}
.voice-info { flex: 1; min-width: 0; }
.voice-name { font-size: 13px; font-weight: 600; }
.voice-file { font-size: 10px; color: var(--text-muted); font-family: var(--font-mono); }
.voice-play-btn {
  width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--border-subtle);
  background: transparent; color: var(--text-muted); cursor: pointer; transition: var(--transition);
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.voice-play-btn:hover { border-color: var(--border-accent); color: var(--text-primary); background: rgba(255,255,255,0.04); }
.voice-play-btn.playing { color: var(--pink); border-color: rgba(236,72,153,0.4); background: rgba(236,72,153,0.08); }

/* My Storyboards list */
.storyboard-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; margin-bottom: 32px; }
.storyboard-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
.storyboard-item {
  display: flex; flex-direction: column; gap: 10px;
  padding: 16px 18px; border-radius: var(--radius-lg);
  border: 1px solid var(--border-subtle); background: var(--bg-card);
  cursor: pointer; transition: var(--transition);
}
.storyboard-item:hover { border-color: var(--border-accent); background: var(--bg-card-hover); transform: translateY(-1px); }
.storyboard-item-header { display: flex; align-items: center; gap: 10px; }
.storyboard-item-icon {
  width: 36px; height: 36px; border-radius: 10px; flex-shrink: 0;
  background: linear-gradient(135deg, rgba(99,102,241,0.12), rgba(139,92,246,0.08));
  border: 1px solid rgba(99,102,241,0.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 16px;
}
.storyboard-item-title { font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1; min-width: 0; }
.storyboard-item-meta { font-size: 11px; color: var(--text-muted); display: flex; gap: 10px; flex-wrap: wrap; }
.storyboard-item-meta span { display: flex; align-items: center; gap: 3px; }
.storyboard-item-actions { display: flex; gap: 6px; }
.storyboard-item-actions button { flex: 1; white-space: nowrap; }
.storyboard-item.generating { border-color: rgba(245,158,11,0.4); }
.storyboard-item.generating .storyboard-item-icon { background: linear-gradient(135deg, rgba(245,158,11,0.15), rgba(239,68,68,0.08)); border-color: rgba(245,158,11,0.3); }
.storyboard-gen-status {
  font-size: 11px; font-weight: 600; padding: 3px 10px; border-radius: 20px;
  display: inline-flex; align-items: center; gap: 5px; width: fit-content;
}
.storyboard-gen-status.running { color: var(--warning); background: var(--warning-glow); }
.storyboard-gen-status.running::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--warning); animation: pulse 1.5s ease-in-out infinite; }
.storyboard-gen-status.pending { color: var(--text-muted); background: rgba(255,255,255,0.04); }
.storyboard-gen-status.done { color: var(--success); background: var(--success-glow); }
.sb-btn-sm {
  padding: 6px 12px; border-radius: 6px; font-size: 11px; font-weight: 600;
  border: 1px solid var(--border-subtle); background: var(--bg-glass);
  color: var(--text-secondary); cursor: pointer; transition: var(--transition);
}
.sb-btn-sm:hover { border-color: var(--border-accent); color: var(--text-primary); }
.sb-btn-sm.primary { border-color: rgba(16,185,129,0.3); color: var(--success); background: var(--success-glow); }
.sb-btn-sm.primary:hover { background: rgba(16,185,129,0.2); }

/* ── Responsive ──────────────────────────────────────────────── */
@media (max-width:1200px) {
  .monitor-layout { grid-template-columns: 280px 1fr 300px; }
  .repo-sidebar { width: 240px; min-width: 240px; }
}
@media (max-width:960px) {
  .monitor-layout { grid-template-columns:1fr; grid-template-rows:auto auto 1fr auto; height:auto; }
  .panel-left, .panel-right { max-height:50vh; }
  #view-repo.active { flex-direction: column; }
  .repo-sidebar { width: 100%; min-width: auto; max-height: 40vh; border-right: none; border-bottom: 1px solid var(--border-subtle); }
  .unit-modal-body { flex-direction: column; }
  .unit-modal-right { width: 100%; min-width: auto; border-left: none; border-top: 1px solid var(--border-subtle); max-height: 50vh; }
  .create-hero { padding: 22px 18px; border-radius: 20px; }
  .create-hero-grid { grid-template-columns: 1fr; }
  .create-hero-visual { min-height: 280px; }
  .create-mode-cards { flex-direction: column; }
  .create-pipeline.active { flex-direction: column; }
  .pipeline-stepper { width: 100%; min-width: auto; flex-direction: row; flex-wrap: wrap; }
  .step-item:not(:last-child)::after { display: none; }
  .create-editor.active { flex-direction: column; }
  .editor-sidebar { width: 100%; min-width: auto; max-height: 40vh; border-right: none; border-bottom: 1px solid var(--border-subtle); }
  .form-row { flex-direction: column; }
  .nav-rail { width: 56px; min-width: 56px; }
  .nav-btn, .nav-tutorial-btn, .nav-user-btn { width: 44px; height: 44px; font-size: 8px; }
  .nav-btn svg, .nav-tutorial-btn svg { width: 18px; height: 18px; }
}
@media (max-width:640px) {
  .create-container { padding: 24px 18px; }
  .create-hero-title { max-width: none; }
  .create-hero-actions { align-items: flex-start; }
  .create-hero-visual { min-height: 250px; padding: 14px; }
  .create-hero-panel { grid-template-columns: 1fr; }
  .create-hero-card-value { font-size: 16px; }
  .create-submit-action { min-width: 100%; max-width: none; }
  .quick-chat-header { flex-direction: column; align-items: flex-start; }
  .quick-chat-subtitle { margin-left: 0; }
}
</style>
</head>
<body>
<div class="bg-mesh"></div>
<div class="app" id="app">

  <!-- Left Navigation Rail -->
  <nav class="nav-rail">
    <div class="nav-logo">V</div>
    <button class="nav-btn active" data-tab="create" onclick="switchTab('create')" title="Create">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
      <span data-i18n="nav.create">创建</span>
    </button>
    <button class="nav-btn" data-tab="assets" onclick="switchTab('assets')" title="Assets">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
      <span data-i18n="nav.assets">素材</span>
    </button>
    <button class="nav-btn" data-tab="monitor" onclick="monitorBrowseMode=null; switchTab('monitor')" title="Creation Desk">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
      <span data-i18n="nav.monitor">创作台</span>
    </button>
    <button class="nav-btn" data-tab="repo" onclick="switchTab('repo')" title="History">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 20h16a2 2 0 002-2V8a2 2 0 00-2-2h-7.93a2 2 0 01-1.66-.9l-.82-1.2A2 2 0 007.93 3H4a2 2 0 00-2 2v13c0 1.1.9 2 2 2z"/></svg>
      <span data-i18n="nav.history">历史</span>
    </button>
    <div class="nav-spacer"></div>
    <div class="nav-tutorial-stack">
      <button class="nav-tutorial-btn" onclick="openTutorialModal()" title="使用说明">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17" stroke-linecap="round" stroke-width="2.5"/></svg>
        <span>教程</span>
      </button>
      <button class="nav-tutorial-btn" onclick="openCreditRulesModal()" title="积分规则">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1v22"/><path d="M17 5H9.5a3.5 3.5 0 000 7H14.5a3.5 3.5 0 010 7H6"/></svg>
        <span>积分</span>
      </button>
    </div>
    <div class="nav-indicator" id="live-indicator"><div class="live-dot"></div>LIVE</div>
    <span class="nav-credits-badge hidden" id="nav-credits-badge" title="积分余额" onclick="openUserMenu()">⚡ <span id="nav-credits-value">--</span></span>
    <button class="nav-user-btn" id="user-menu-btn" onclick="handleUserEntryClick()" title="账户">
      <span class="nav-user-avatar" id="nav-user-avatar">U</span>
      <span class="nav-user-label" id="nav-user-label">登录</span>
    </button>
    <button class="nav-btn" id="lang-toggle-btn" onclick="toggleLang()" title="Switch Language" style="margin-top:4px;font-size:11px;font-weight:700;letter-spacing:0.5px">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
      <span id="lang-label">EN</span>
    </button>
  </nav>

  <!-- Main Content Area -->
  <div class="main-content">

  <!-- Hidden topbar elements we still need for logic -->
  <span id="project-title" style="display:none"></span>
  <span id="current-project-name" style="display:none">Projects</span>

  <!-- Projects Drawer -->
  <div class="drawer-backdrop" id="drawer-backdrop" onclick="toggleDrawer(false)"></div>
  <div class="projects-drawer" id="projects-drawer">
    <div class="drawer-header">
      <span class="drawer-title" data-i18n="drawer.title">项目</span>
      <span class="drawer-count" id="drawer-count">0 projects</span>
    </div>
    <div class="drawer-list" id="drawer-list"></div>
  </div>

  <!-- hidden run select for data -->
  <select class="run-select" id="run-select" style="display:none"><option value="">No runs</option></select>

  <!-- ═══ View: Monitor ═══ -->
  <div id="view-monitor" class="view">
    <div class="monitor-header">
      <div class="monitor-title-text" data-i18n="monitor.title">创作台</div>
      <div style="flex:1"></div>
      <div class="nav-indicator" id="monitor-live-indicator"><div class="live-dot"></div><span>LIVE</span></div>
    </div>
    <div id="monitor-active-jobs" style="flex:1;display:flex;flex-direction:column;overflow:hidden;">
      <!-- Active jobs list + selected job detail will be rendered here -->
    </div>
  </div>

  <!-- ═══ View: Create ═══ -->
  <div id="view-create" class="view active">
    <div class="create-container">
      <div class="create-hero" id="create-home-hero">
        <div class="create-hero-grid">
          <div class="create-hero-copy">
            <div class="create-hero-badge" data-i18n="hero.badge">AI VIDEO AGENT</div>
            <h1 class="create-hero-title">
              <span class="create-hero-title-main" data-i18n="hero.title_main">从一句创意开始</span>
              <span class="create-hero-title-highlight" data-i18n="hero.title_highlight">一键生成分镜与成片</span>
            </h1>
            <p class="create-hero-subtitle" data-i18n="hero.subtitle">把小说、视频或一句灵感，快速转成可编辑分镜、统一角色素材，并生成带丝滑过渡的长视频。</p>
            <div class="create-hero-actions">
              <button class="create-hero-cta" onclick="document.getElementById('create-form-phase')?.scrollIntoView({ behavior: 'smooth', block: 'start' })">
                <span data-i18n="hero.cta">立即开始创作</span>
                <span>→</span>
              </button>
              <span class="create-hero-note" data-i18n="hero.note">开始创作适合与 Agent 协作推进，一键成片则由全流程 Agent 接管并直出视频。</span>
            </div>
            <div class="create-hero-features">
              <div class="create-hero-chip" data-i18n="hero.feature_1">丝滑过渡与一致性</div>
              <div class="create-hero-chip" data-i18n="hero.feature_2">热门长视频复刻</div>
              <div class="create-hero-chip" data-i18n="hero.feature_3">Agent 自动质检</div>
              <div class="create-hero-chip" data-i18n="hero.feature_4">即梦代理模式</div>
            </div>
          </div>
          <div class="create-hero-visual" aria-hidden="true">
            <div class="create-hero-orbit">
              <div class="create-hero-node node-a"></div>
              <div class="create-hero-node node-b"></div>
              <div class="create-hero-node node-c"></div>
              <div class="create-hero-node node-d"></div>
            </div>
            <div class="create-hero-panel">
              <div class="create-hero-card">
                <div class="create-hero-card-label" data-i18n="hero.card_1_label">CONSISTENCY</div>
                <div class="create-hero-card-value" data-i18n="hero.card_1_value">丝滑过渡与角色/场景一致性</div>
                <div class="create-hero-card-sub" data-i18n="hero.card_1_sub">长视频生成过程中保持镜头衔接更自然，角色与场景设定更稳定，不容易跳戏。</div>
              </div>
              <div class="create-hero-card">
                <div class="create-hero-card-label" data-i18n="hero.card_2_label">RECREATION</div>
                <div class="create-hero-card-value" data-i18n="hero.card_2_value">热门长视频复刻</div>
                <div class="create-hero-card-sub" data-i18n="hero.card_2_sub">从热门视频快速拆解并复刻长视频结构、节奏与画面感觉，适合二创和高效起盘。</div>
              </div>
              <div class="create-hero-card">
                <div class="create-hero-card-label" data-i18n="hero.card_3_label">AGENT QA</div>
                <div class="create-hero-card-value" data-i18n="hero.card_3_value">智能 Agent 自动质检与抽卡</div>
                <div class="create-hero-card-sub" data-i18n="hero.card_3_sub">Agent 会自主完成质检、抽卡与多轮迭代优化，无需人工排队抽卡，直接交付成片。</div>
              </div>
              <div class="create-hero-card">
                <div class="create-hero-card-label" data-i18n="hero.card_4_label">PROXY MODE</div>
                <div class="create-hero-card-value" data-i18n="hero.card_4_value">代理模式：使用用户即梦</div>
                <div class="create-hero-card-sub" data-i18n="hero.card_4_sub">支持直接使用用户自己的即梦账号生成视频，在保证工作流一致的同时做到超高性价比。</div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Back button (hidden initially) -->
      <div class="create-back-row" id="create-back-row" style="display:none">
        <button class="btn-secondary" onclick="createGoBack()"><span data-i18n="create.back">← 返回</span></button>
      </div>
      <div class="create-active-banner" id="create-active-banner">
        <div class="create-active-banner-meta">
          <div class="create-active-banner-title" id="create-active-banner-title"></div>
          <div class="create-active-banner-desc" id="create-active-banner-desc"></div>
        </div>
        <div class="create-active-banner-actions">
          <button class="btn-secondary" id="create-return-job-btn" onclick="returnToActiveCreateJob()" data-i18n="create.return_job">返回任务</button>
          <button class="btn-secondary" id="create-pause-job-btn" onclick="pauseCurrentCreateJob()" style="display:none">⏸ 暂停</button>
          <button class="btn-secondary" id="create-resume-job-btn" onclick="resumeCurrentCreateJob()" style="display:none">▶ 继续</button>
          <button class="btn-danger-soft" id="create-stop-job-btn" onclick="stopCurrentCreateJob()" style="display:none">🗑 删除</button>
        </div>
      </div>

      <!-- Phase A: Mode Selection + Form -->
      <div id="create-form-phase">
        <div class="section-title" style="margin-bottom:20px;font-size:13px" data-i18n="create.new_storyboard">创建新剧本</div>
        <div class="create-mode-cards">
              <div class="mode-card" data-mode="novel" onclick="selectCreateMode('novel')">
                <div class="mode-card-icon">📖</div>
                <div class="mode-card-title" data-i18n="create.mode.novel">小说</div>
                <div class="mode-card-desc" data-i18n="create.mode.novel_desc">从小说章节或文本段落生成分镜</div>
              </div>
              <div class="mode-card" data-mode="video" onclick="selectCreateMode('video')">
                <div class="mode-card-icon">🎬</div>
                <div class="mode-card-title" data-i18n="create.mode.video">视频</div>
                <div class="mode-card-desc" data-i18n="create.mode.video_desc">复刻或二创现有视频为分镜</div>
              </div>
              <div class="mode-card" data-mode="prompt" onclick="selectCreateMode('prompt')">
                <div class="mode-card-icon">✨</div>
                <div class="mode-card-title" data-i18n="create.mode.prompt">创作模式</div>
                <div class="mode-card-desc" data-i18n="create.mode.prompt_desc">从创意文字描述生成分镜</div>
              </div>
            </div>

            <div class="create-form" id="create-form">
          <!-- Common fields -->
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" data-i18n="form.title">标题</label>
              <input class="form-input" id="create-title" data-i18n-placeholder="form.title_placeholder" placeholder="输入项目标题" />
            </div>
            <div class="form-group">
              <label class="form-label" data-i18n="form.style">风格</label>
              <input class="form-input" id="create-style" data-i18n-placeholder="form.style_placeholder" placeholder="留空自动解析，也可输入风格文本" />
            </div>
            <div class="form-group">
              <label class="form-label" data-i18n="form.duration">时长（秒）</label>
              <input class="form-input" id="create-duration" type="number" placeholder="60" value="60" />
            </div>
          </div>

          <!-- Novel fields -->
          <div class="mode-fields" id="fields-novel">
            <div class="form-group">
              <label class="form-label" data-i18n="form.novel_text">小说文本</label>
              <div class="file-upload-zone" id="novel-upload-zone" onclick="document.getElementById('novel-file-input').click()">
                <input type="file" id="novel-file-input" accept=".txt,.md" onchange="handleNovelUpload(this)" />
                <div data-i18n="form.upload_txt">点击上传 .txt 文件，或在下方粘贴文本</div>
              </div>
            </div>
            <div class="form-group">
              <label class="form-label" data-i18n="form.paste_text">或直接粘贴文本</label>
              <textarea class="form-textarea" id="create-novel-text" data-i18n-placeholder="form.paste_placeholder" placeholder="在此粘贴小说章节..." rows="6"></textarea>
            </div>
            <div class="form-group">
              <label class="form-label" data-i18n="form.style_hint">风格提示（可选）</label>
              <input class="form-input" id="create-novel-style-hint" data-i18n-placeholder="form.style_hint_placeholder" placeholder="额外的风格描述" />
            </div>
          </div>

          <!-- Video fields -->
          <div class="mode-fields" id="fields-video">
            <div class="form-group">
              <label class="form-label" data-i18n="form.video_file">视频文件</label>
              <div class="file-upload-zone" id="video-upload-zone" onclick="document.getElementById('video-file-input').click()">
                <input type="file" id="video-file-input" accept="video/*" onchange="handleVideoUpload(this)" />
                <div id="video-upload-hint" data-i18n="form.upload_video">点击或拖入视频文件</div>
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" data-i18n="form.mode">模式</label>
                <select class="form-select" id="create-video-mode" onchange="toggleVideoRecreateDirection()">
                  <option value="replicate" data-i18n="mode.replicate">复刻 (Replicate)</option>
                  <option value="recreate" data-i18n="mode.recreate">二创 (Recreate)</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label" data-i18n="form.num_scenes">场景数（可选）</label>
                <input class="form-input" id="create-video-scenes" type="number" data-i18n-placeholder="form.auto" placeholder="自动" />
              </div>
            </div>
            <div class="form-group" id="video-recreate-direction-group" style="display:none">
              <label class="form-label" data-i18n="form.recreate_direction">二创方向（可选）</label>
              <textarea class="form-textarea" id="create-video-recreate-direction" data-i18n-placeholder="form.recreate_direction_placeholder" placeholder="可提前告诉 AI 想往什么方向二创，比如：改成更燃的逆袭爽文、突出师徒反目、改成黑色幽默等。不填则按默认逻辑创作。" rows="4"></textarea>
              <div class="form-help" data-i18n="form.recreate_direction_help">只在“二创”模式下生效，可留空。</div>
            </div>
          </div>

          <!-- Prompt fields -->
          <div class="mode-fields" id="fields-prompt">
            <div class="form-group">
              <label class="form-label" data-i18n="form.creative_desc">创意描述</label>
              <textarea class="form-textarea" id="create-prompt-idea" data-i18n-placeholder="form.creative_placeholder" placeholder="描述你的创意构想... 例如：修仙少年雷劫中觉醒剑意，逆转乾坤" rows="5"></textarea>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" data-i18n="form.style_hint">风格提示（可选）</label>
                <input class="form-input" id="create-prompt-style-hint" data-i18n-placeholder="form.style_hint_placeholder" placeholder="额外的风格描述" />
              </div>
              <div class="form-group">
                <label class="form-label" data-i18n="form.num_scenes">场景数（可选）</label>
                <input class="form-input" id="create-prompt-scenes" type="number" data-i18n-placeholder="form.auto" placeholder="自动" />
              </div>
            </div>
          </div>

          <div class="create-submit-row">
            <div class="create-submit-action">
              <button class="btn-primary" id="create-submit-btn" onclick="submitCreate()" disabled data-i18n="create.start_gen">开始创作</button>
              <div class="create-submit-hint" data-i18n="create.start_gen_hint">和 Agent 协作交互创作，可边生成边调整内容、节奏和分镜细节。</div>
            </div>
            <div class="create-submit-action one-click">
              <button class="btn-secondary btn-one-click" id="create-one-click-btn" onclick="submitCreate(true)" disabled data-i18n="create.one_click">一键成片</button>
              <div class="create-submit-hint" data-i18n="create.one_click_hint">由全流程 Agent 全面接管，从创意直接推进到成片并直出视频。</div>
            </div>
            <span id="create-submit-status" style="font-size:12px;color:var(--text-muted)"></span>
          </div>
      </div>

      <!-- Quick Chat Bar -->
      <div class="quick-chat-wrap" id="quick-chat-wrap">
        <div class="quick-chat-header">
          <div class="quick-chat-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/>
            </svg>
          </div>
          <span class="quick-chat-title">一句话成片</span>
          <span class="quick-chat-subtitle">全流程 Agent 全面接管：输入创意后自动生成剧本 → 分镜 → 生成视频 → 质检抽卡 → 剪辑 → 成片</span>
        </div>
        <div class="quick-chat-box">
          <textarea
            class="quick-chat-textarea"
            id="quick-chat-input"
            rows="1"
            placeholder="描述你的创意，例如：修仙少年雷劫中觉醒剑意，逆转乾坤，3D国漫风格，60秒..."
            onInput="quickChatAutoResize(this); quickChatUpdateSend()"
            onKeydown="quickChatKeydown(event)"
          ></textarea>
          <button class="quick-chat-send" id="quick-chat-send" disabled onclick="quickChatSubmit()" title="一键成片">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>
        </div>
        <div class="quick-chat-hints">
          <span class="quick-chat-hint-chip" onclick="quickChatFill(this)">修仙少年雷劫觉醒，逆转乾坤</span>
          <span class="quick-chat-hint-chip" onclick="quickChatFill(this)">都市精英穿越古代，运筹帷幄</span>
          <span class="quick-chat-hint-chip" onclick="quickChatFill(this)">末日废土中的最后一支军队</span>
          <span class="quick-chat-hint-chip" onclick="quickChatFill(this)">少女与机甲，星际逃亡之旅</span>
        </div>
      </div>

      <!-- Divider -->
      <div class="create-divider"></div>

      <!-- My Storyboards (below Create) -->
      <div id="my-storyboards-section">
        <div class="section-title" style="margin-bottom:14px;font-size:13px" data-i18n="create.my_storyboards">我的剧本</div>
        <div class="storyboard-list" id="storyboard-list">
          <div style="color:var(--text-muted);font-size:13px;padding:12px" data-i18n="create.loading">加载中...</div>
        </div>
      </div>

      <!-- Phase B: Pipeline -->
      <div class="create-pipeline" id="create-pipeline-phase">
        <div class="pipeline-stepper" id="pipeline-stepper">
          <div class="step-item" data-step="screenplay" id="step-screenplay" onclick="onStepClick('screenplay')">
            <div class="step-icon">1</div>
            <div class="step-info"><div class="step-title" data-i18n="pipeline.screenplay">剧本</div><div class="step-desc" data-i18n="pipeline.screenplay_desc">从素材生成剧本</div></div>
          </div>
          <div class="step-item" data-step="storyboard" id="step-storyboard" onclick="onStepClick('storyboard')">
            <div class="step-icon">2</div>
            <div class="step-info"><div class="step-title" data-i18n="pipeline.storyboard">分镜</div><div class="step-desc" data-i18n="pipeline.storyboard_desc">转换为视觉分镜</div></div>
          </div>
          <div class="step-item" data-step="done" id="step-done" onclick="onStepClick('done')">
            <div class="step-icon">3</div>
            <div class="step-info"><div class="step-title" data-i18n="pipeline.complete">完成</div><div class="step-desc" data-i18n="pipeline.complete_desc">最终分镜</div></div>
          </div>
        </div>
        <div class="pipeline-content" id="pipeline-content">
          <div class="pipeline-waiting"><div class="live-dot"></div> <span data-i18n="pipeline.waiting">等待生成开始...</span></div>
        </div>
      </div>

      <!-- Phase C: Editor -->
      <div class="create-editor" id="create-editor-phase">
        <div class="editor-sidebar" id="editor-sidebar">
          <div class="editor-sidebar-section">
            <div class="editor-sidebar-head">
              <div class="editor-sidebar-title" data-i18n="editor.characters">角色</div>
              <button class="editor-add-btn" onclick="openEntityEditor('character')" data-i18n="editor.add">新增</button>
            </div>
            <div id="editor-characters"></div>
          </div>
          <div class="editor-sidebar-section">
            <div class="editor-sidebar-head">
              <div class="editor-sidebar-title" data-i18n="editor.locations">场景</div>
              <button class="editor-add-btn" onclick="openEntityEditor('location')" data-i18n="editor.add">新增</button>
            </div>
            <div id="editor-locations"></div>
          </div>
          <div class="editor-sidebar-section">
            <div class="editor-sidebar-head">
              <div class="editor-sidebar-title" data-i18n="editor.props">道具</div>
              <button class="editor-add-btn" onclick="openEntityEditor('prop')" data-i18n="editor.add">新增</button>
            </div>
            <div id="editor-props"></div>
          </div>
        </div>
        <div class="editor-main">
          <div class="editor-main-header">
            <div class="editor-header-main">
              <input type="text" class="editor-title-input" id="editor-title" data-i18n-placeholder="editor.title_placeholder" placeholder="分镜标题" />
              <div class="editor-duration-box">
                <span class="editor-duration-label" data-i18n="editor.total_duration">总时长</span>
                <input type="number" class="editor-duration-input" id="editor-total-duration" min="1" step="0.1" />
                <span class="scene-duration-suffix">秒</span>
              </div>
            </div>
            <span style="font-size:12px;color:var(--text-muted)" id="editor-scene-count"></span>
          </div>
          <div class="editor-scene-list" id="editor-scene-list"></div>
          <div class="editor-actions">
            <div style="display:flex;align-items:center;gap:8px;flex:1">
              <select id="editor-generation-mode" class="backend-select" title="生成模式">
                <option value="parallel">⚡ 并行生成</option>
                <option value="sequential">🔗 串行过渡桥接</option>
              </select>
              <div class="editor-proxy-toggle" id="editor-proxy-toggle">
                <button type="button" style="display:flex;align-items:center;gap:5px;cursor:pointer;font-size:12px;color:var(--text-secondary);white-space:nowrap;background:transparent;border:none;padding:0" onclick="onEditorProxyToggle()">
                  <span>🔑</span> <span>生成 Session</span>
                </button>
                <span class="editor-proxy-session-badge" id="editor-proxy-badge" style="display:none" onclick="openProxyCookieModal()"></span>
              </div>
              <button class="btn-primary" onclick="saveStoryboard()">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px">
                  <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/>
                </svg>
                <span data-i18n="editor.save_only">仅保存</span>
              </button>
              <button class="btn-primary btn-generate-video" onclick="saveAndGenerate()" style="background:linear-gradient(135deg,var(--success),#059669)">
                <span style="margin-right:6px">▶</span> <span data-i18n="editor.save_generate">保存并生成</span>
              </button>
            </div>
            <button class="btn-secondary" onclick="openInMonitor()" style="display:none" id="btn-open-monitor" data-i18n="editor.open_monitor">在创作台中打开</button>
            <span id="editor-save-status" style="font-size:12px;color:var(--text-muted)"></span>
          </div>
        </div>
      </div>

      <input type="file" class="hidden-upload" id="entity-image-upload" accept="image/*" />
    </div>
  </div>

  <!-- ═══ View: Assets Library ═══ -->
  <div id="view-assets" class="view">
    <div class="assets-header">
      <div class="assets-header-top">
        <div class="assets-title" data-i18n="assets.title">素材库</div>
        <div class="assets-toolbar">
          <button class="btn-primary assets-upload-btn" id="assets-upload-btn" onclick="openAssetUploadPicker()" data-i18n="assets.upload">上传本地图片</button>
        </div>
      </div>
      <div class="assets-tabs">
        <button class="assets-tab active" data-atype="characters" onclick="switchAssetTab('characters')">
          <span data-i18n="assets.characters">角色</span> <span class="assets-tab-count" id="asset-count-characters">0</span>
        </button>
        <button class="assets-tab" data-atype="locations" onclick="switchAssetTab('locations')">
          <span data-i18n="assets.locations">场景</span> <span class="assets-tab-count" id="asset-count-locations">0</span>
        </button>
        <button class="assets-tab" data-atype="props" onclick="switchAssetTab('props')">
          <span data-i18n="assets.props">道具</span> <span class="assets-tab-count" id="asset-count-props">0</span>
        </button>
        <button class="assets-tab" data-atype="voices" onclick="switchAssetTab('voices')">
          <span data-i18n="assets.voices">配音</span> <span class="assets-tab-count" id="asset-count-voices">0</span>
        </button>
      </div>
    </div>
    <div class="assets-body" id="assets-body">
      <div style="color:var(--text-muted);font-size:14px;padding:20px" data-i18n="assets.loading">加载素材中...</div>
    </div>
  </div>

  <!-- ═══ View: Repository ═══ -->
  <div id="view-repo" class="view">
    <div class="repo-sidebar" id="repo-sidebar">
      <div class="repo-sidebar-header">
        <span data-i18n="repo.projects">项目</span>
        <span id="repo-project-count" style="font-family:var(--font-mono)">0</span>
      </div>
      <div id="repo-project-list"></div>
    </div>
    <div class="repo-content" id="repo-content">
      <div class="empty-state" id="repo-empty">
        <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 20h16a2 2 0 002-2V8a2 2 0 00-2-2h-7.93a2 2 0 01-1.66-.9l-.82-1.2A2 2 0 007.93 3H4a2 2 0 00-2 2v13c0 1.1.9 2 2 2z"/></svg>
        <div style="font-size:16px;font-weight:600" data-i18n="repo.select_project">选择一个项目</div>
        <div data-i18n="repo.browse_hint">从侧边栏浏览历史生成</div>
      </div>
    </div>
  </div>

</div>

<!-- Video Lightbox -->
<div class="lightbox" id="video-lightbox">
  <button class="lightbox-close" onclick="closeLightbox()">&times;</button>
  <div class="lightbox-content"><video id="lightbox-video" controls></video></div>
</div>
<!-- Image Lightbox -->
<div class="img-lightbox" id="img-lightbox" onclick="closeImgLightbox()">
  <img id="img-lightbox-img" src="">
</div>

<!-- Entity Detail Modal (character / location / prop) -->
<div class="unit-modal-backdrop" id="entity-detail-modal" onclick="if(event.target===this)closeEntityModal()" style="display:none">
  <div class="unit-modal" style="max-width:640px;width:92vw">
    <div class="unit-modal-header">
      <div class="unit-modal-title" id="entity-modal-title">角色详情</div>
      <button class="unit-modal-close" onclick="closeEntityModal()">✕</button>
    </div>
    <div style="padding:20px 24px;overflow-y:auto;max-height:70vh" id="entity-modal-body"></div>
  </div>
</div>

<!-- Editor Scene Detail Modal -->
<div class="unit-modal-backdrop" id="editor-scene-modal" onclick="if(event.target===this)closeEditorSceneModal()">
  <div class="unit-modal">
    <div class="unit-modal-header">
      <div class="unit-modal-nav">
        <button class="unit-nav-btn" id="editor-scene-nav-prev" onclick="navigateEditorScene(-1)" title="Previous scene">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <div class="unit-modal-title">
          <span id="editor-scene-modal-title"></span>
          <span id="editor-scene-modal-nav" style="font-size:12px;color:var(--text-muted);font-weight:400"></span>
        </div>
        <button class="unit-nav-btn" id="editor-scene-nav-next" onclick="navigateEditorScene(1)" title="Next scene">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
      <button class="unit-modal-close" onclick="closeEditorSceneModal()">&times;</button>
    </div>
    <div class="unit-modal-body" style="flex-direction:column">
      <div style="flex:1;overflow-y:auto;padding:24px">
        <div id="editor-scene-modal-content"></div>
      </div>
    </div>
  </div>
</div>

<!-- Unit Detail Modal -->
<div class="unit-modal-backdrop" id="unit-modal" onclick="if(event.target===this)closeUnitModal()">
  <div class="unit-modal">
    <div class="unit-modal-header">
      <div class="unit-modal-nav">
        <button class="unit-nav-btn" id="unit-nav-prev" onclick="navigateUnit(-1)" title="Previous unit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <div class="unit-modal-title">
          <span id="unit-modal-id"></span>
          <span id="unit-modal-nav-label" style="font-size:12px;color:var(--text-muted);font-weight:400"></span>
          <div id="unit-modal-status" class="unit-status"></div>
        </div>
        <button class="unit-nav-btn" id="unit-nav-next" onclick="navigateUnit(1)" title="Next unit">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
      </div>
      <button class="unit-modal-close" onclick="closeUnitModal()">&times;</button>
    </div>
    <div class="unit-modal-body">
      <div class="unit-modal-left">
        <video id="unit-modal-video" controls></video>
        <div id="unit-modal-video-empty" style="display:none;align-items:center;justify-content:center;min-height:320px;padding:24px;color:var(--text-muted);font-size:13px;text-align:center;background:#000;border-bottom:1px solid var(--border-subtle)"></div>
        <div id="unit-modal-media-actions-slot"></div>
        <div class="unit-modal-attempts-bar" id="unit-modal-attempts"></div>
      </div>
      <div class="unit-modal-right">
        <div class="unit-modal-tabs">
          <button class="unit-modal-tab active" data-panel="prompt" onclick="switchModalTab('prompt')" data-i18n="modal.prompt">提示词</button>
          <button class="unit-modal-tab" data-panel="critique" onclick="switchModalTab('critique')" data-i18n="modal.critique">评审</button>
          <button class="unit-modal-tab" data-panel="info" onclick="switchModalTab('info')" data-i18n="modal.info">信息</button>
        </div>
        <div class="unit-modal-panel active" id="modal-panel-prompt">
          <div class="modal-section-label" data-i18n="modal.prompt">提示词</div>
          <div id="modal-prompt-actions"></div>
        </div>
        <div class="unit-modal-panel" id="modal-panel-critique">
          <div class="modal-section-label" data-i18n="modal.critique_result">评审结果</div>
          <div id="modal-critique-content"></div>
        </div>
        <div class="unit-modal-panel" id="modal-panel-info">
          <div class="modal-section-label" data-i18n="modal.unit_details">单元详情</div>
          <div id="modal-info-content"></div>
        </div>
      </div>
    </div>
  </div>
  </div><!-- end main-content -->
</div><!-- end app -->

<!-- Segment Preview Modal -->
<div class="segment-modal-overlay" id="segment-modal-overlay" onclick="if(event.target===this) closeSegmentModal()">
  <div class="segment-modal">
    <div class="segment-modal-header">
      <div class="segment-modal-title" id="segment-modal-title">Segment 1</div>
      <div style="display:flex;align-items:center;gap:12px">
        <div class="segment-modal-nav">
          <button class="segment-nav-btn" id="segment-prev-btn" onclick="navigateSegment(-1)" title="Previous">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
          </button>
          <button class="segment-nav-btn" id="segment-next-btn" onclick="navigateSegment(1)" title="Next">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
        <button class="segment-modal-close" onclick="closeSegmentModal()">&times;</button>
      </div>
    </div>
    <div class="segment-modal-body" id="segment-modal-body">
      <div class="segment-narrative" id="segment-narrative">Loading...</div>
      <div class="segment-scenes-title" data-i18n="segment.scenes_in">此段落中的场景</div>
      <div id="segment-scenes-list"></div>
    </div>
  </div>
</div>

<script>
// ── State ──────────────────────────────────────────────────────
let currentData = null;
let ws = null;
let reconnectTimer = null;
let repoData = null;
let projectList = [];
let activeProject = null;
let videoJobsData = [];
let selectedVideoJobId = null;
let currentTab = document.querySelector('.nav-btn.active')?.dataset.tab || 'create';
let monitorBrowseMode = null; // { project, run_id } when viewing from History
let currentAssetTab = 'characters';
let assetData = null;
let assetDataLoadingPromise = null;
let voiceData = null;
let currentAudioEl = null;
let assetUploadFile = null;
let currentUser = null;
let currentCsrfToken = '';
let adminUsers = [];
let creditsHistoryPage = 1;
let creditsHistoryItems = [];
const nativeFetch = window.fetch.bind(window);
let assetUploadContext = {
  mode: 'assets-library',
  category: null,
  afterUpload: null,
};
let promptAssetPickerContext = null;
let monitorActionState = {
  concat: false,
  deleteFinal: false,
};
let concatMode = localStorage.getItem('concat_mode') || 'hard';
let concatFadeSeconds = Number(localStorage.getItem('concat_fade_seconds') || '0.5');
if (!Number.isFinite(concatFadeSeconds) || concatFadeSeconds <= 0) concatFadeSeconds = 0.5;

/** 监控页左侧「活跃任务」栏折叠状态（避免每次 WS 刷新后整块 DOM 重建导致侧栏又展开） */
let monitorJobsPanelCollapsed = localStorage.getItem('dashboard_monitor_jobs_collapsed') === '1';
function setMonitorJobsPanelCollapsed(collapsed) {
  monitorJobsPanelCollapsed = !!collapsed;
  localStorage.setItem('dashboard_monitor_jobs_collapsed', monitorJobsPanelCollapsed ? '1' : '0');
}

/** full_update 时合并多次刷新，减少对成片/单元详情的打断 */
let _debounceBrowsePaneRefreshTimer = null;
function clearDebouncedBrowsePaneRefresh() {
  if (_debounceBrowsePaneRefreshTimer) {
    clearTimeout(_debounceBrowsePaneRefreshTimer);
    _debounceBrowsePaneRefreshTimer = null;
  }
}
function scheduleDebouncedBrowsePaneRefresh() {
  clearDebouncedBrowsePaneRefresh();
  _debounceBrowsePaneRefreshTimer = setTimeout(() => {
    _debounceBrowsePaneRefreshTimer = null;
    const pane = document.getElementById('monitor-detail-pane');
    if (
      pane
      && document.getElementById('view-monitor')?.classList.contains('active')
      && shouldRefreshMonitorBrowseInPlace(pane)
    ) {
      if (maybeApplyIncrementalBrowseWsRefresh(pane)) return;
      _renderMonitorBrowse(pane);
    }
  }, 750);
}

/** WebSocket 刷新用：对比签名，尽量只改工具栏+胶片条或仅重绘当前单元详情 */
let _browseLiveSigCache = null;

function computeBrowseRefreshSigsFromState(st) {
  const finSig = `${currentData?.storyboard_name}|${currentData?.run_id}|${st.media?.final || ''}|${st.media?.final_mtime ?? ''}`;
  const filmSig = `${st.unitInfos.map((info) => {
    const u = info.unit;
    const att = (info.displayAttempts || []).map(a =>
      `${a.attempt_id}:${a.status}:${a.output_path || ''}:${a.critique_result ? 1 : 0}`
    ).join(',');
    return `${u.unit_id}:${getUnitStatus(u)}:${info.videoSrc || ''}:${att}`;
  }).join('|')}||F:${st.media?.final || ''}:${st.media?.final_mtime ?? ''}`;
  const tbSig = `${st.completedCount}/${st.units.length}:${st.availableClipCount}:${st.hasFinal}:${st.currentActivityHTML}`;
  let unitSig = '';
  if (browseSelectedUnit >= 0 && browseSelectedUnit < st.unitInfos.length) {
    const info = st.unitInfos[browseSelectedUnit];
    const u = info.unit;
    const att = (info.displayAttempts || []).map(a =>
      `${a.attempt_id}:${a.status}:${a.output_path || ''}:${a.critique_result ? 1 : 0}`
    ).join(',');
    unitSig = `${u.unit_id}:${getUnitStatus(u)}:${info.bestIdx}:${att}`;
  }
  return { filmSig, finSig, tbSig, unitSig };
}

function getCookie(name) {
  const prefix = `${name}=`;
  return document.cookie.split('; ').find(part => part.startsWith(prefix))?.slice(prefix.length) || '';
}

function updateCsrfToken(nextToken) {
  currentCsrfToken = nextToken || getCookie('video_agent_csrf') || '';
}

function getCurrentCsrfToken() {
  if (!currentCsrfToken) updateCsrfToken();
  return currentCsrfToken;
}

async function parseApiJsonSafely(res) {
  const rawText = await res.text();
  if (!rawText) return {};
  try {
    return JSON.parse(rawText);
  } catch (_) {
    if (!res.ok) {
      return { ok: false, error: rawText || `HTTP ${res.status} ${res.statusText}` };
    }
    throw new Error('响应不是有效 JSON');
  }
}

function getUserInitial(user = currentUser) {
  const source = user?.username || user?.role || 'U';
  return String(source).trim().charAt(0).toUpperCase() || 'U';
}

function updateUserUi() {
  const isLoggedIn = !!currentUser;
  const navBtn = document.getElementById('user-menu-btn');
  const navAvatar = document.getElementById('nav-user-avatar');
  const labelEl = document.getElementById('nav-user-label');
  const navCreditsBadge = document.getElementById('nav-credits-badge');
  if (navBtn) navBtn.title = isLoggedIn ? '账户' : '登录';
  if (navAvatar) navAvatar.textContent = isLoggedIn ? getUserInitial() : '登';
  if (labelEl) labelEl.textContent = isLoggedIn ? (currentUser?.username || '账户') : '登录';
  if (navCreditsBadge) navCreditsBadge.classList.toggle('hidden', !isLoggedIn);

  const accountMenu = document.getElementById('user-menu-modal');
  if (accountMenu && !isLoggedIn) accountMenu.classList.remove('show');

  const avatarEls = [document.getElementById('user-menu-avatar')];
  avatarEls.forEach(el => { if (el) el.textContent = getUserInitial(); });
  const username = currentUser?.username || '账户';
  const roleText = currentUser?.role === 'admin' ? '管理员' : '普通用户';
  const nameEl = document.getElementById('user-menu-name');
  if (nameEl) nameEl.textContent = username;
  const nameMetaEl = document.getElementById('user-menu-name-meta');
  if (nameMetaEl) nameMetaEl.textContent = username;
  const roleEl = document.getElementById('user-menu-role');
  if (roleEl) roleEl.textContent = roleText;
  const roleMetaEl = document.getElementById('user-menu-role-meta');
  if (roleMetaEl) roleMetaEl.textContent = roleText;
  const creditsEl = document.getElementById('user-credits-balance');
  if (creditsEl) creditsEl.textContent = currentUser?.credits ?? '--';
  const navCreditsValueEl = document.getElementById('nav-credits-value');
  if (navCreditsValueEl) navCreditsValueEl.textContent = currentUser?.credits ?? '--';
  const adminPanel = document.getElementById('admin-panel');
  if (adminPanel) adminPanel.classList.toggle('hidden', currentUser?.role !== 'admin');
  const sessionUserEl = document.getElementById('user-session-owner');
  if (sessionUserEl) sessionUserEl.textContent = username;
}

function setUserMenuStatus(message = '', type = '') {
  const el = document.getElementById('user-menu-status');
  if (!el) return;
  el.textContent = message;
  el.style.color = type === 'error' ? 'var(--error)' : type === 'success' ? 'var(--success)' : 'var(--text-muted)';
}

async function loadUserCredits() {
  if (!currentUser) return;
  const { response, data } = await apiFetch('/api/credits');
  if (response.ok && data) {
    const val = data.credits ?? '--';
    currentUser = { ...currentUser, credits: val };
    const navEl = document.getElementById('nav-credits-value');
    if (navEl) navEl.textContent = val;
    const balEl = document.getElementById('user-credits-balance');
    if (balEl) balEl.textContent = val;
  }
}

async function redeemCode() {
  const input = document.getElementById('redeem-code-input');
  const code = (input?.value || '').trim();
  if (!code) return;
  const statusEl = document.getElementById('redeem-status');
  if (!statusEl) return;
  statusEl.textContent = '兑换中...';
  statusEl.style.color = 'var(--text-muted)';
  const { response, data } = await apiFetch('/api/credits/redeem', {
    method: 'POST', headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ code }),
  });
  if (response.ok && data?.ok) {
    statusEl.textContent = `兑换成功！+${data.credits_added} 积分，余额 ${data.balance}`;
    statusEl.style.color = 'var(--success)';
    input.value = '';
    currentUser = { ...currentUser, credits: data.balance };
    await loadUserCredits();
    creditsHistoryPage = 1;
    creditsHistoryItems = [];
    if (!document.getElementById('credits-history-panel')?.classList.contains('hidden')) {
      await loadCreditsHistory(true);
    }
  } else {
    statusEl.textContent = data?.error || '兑换失败';
    statusEl.style.color = 'var(--error)';
  }
}

function toggleCreditsHistory() {
  const panel = document.getElementById('credits-history-panel');
  if (!panel) return;
  const isHidden = panel.classList.contains('hidden');
  panel.classList.toggle('hidden');
  if (isHidden) {
    creditsHistoryPage = 1;
    creditsHistoryItems = [];
    loadCreditsHistory(true);
  }
}

async function loadCreditsHistory(reset = false) {
  if (reset) {
    creditsHistoryPage = 1;
    creditsHistoryItems = [];
  }
  const { response, data } = await apiFetch(`/api/credits/history?page=${creditsHistoryPage}&page_size=20`);
  if (!response.ok) return;
  creditsHistoryItems = creditsHistoryItems.concat(data.items || []);
  renderCreditsHistory();
  const moreBtn = document.getElementById('credits-history-more-btn');
  if (moreBtn) moreBtn.classList.toggle('hidden', creditsHistoryItems.length >= (data.total || 0));
}

function loadMoreCreditsHistory() {
  creditsHistoryPage++;
  loadCreditsHistory();
}

function renderCreditsHistory() {
  const el = document.getElementById('credits-history-list');
  if (!el) return;
  if (!creditsHistoryItems.length) {
    el.innerHTML = '<div style="color:var(--text-muted);padding:8px 0">暂无记录</div>';
    return;
  }
  const typeLabels = {
    initial: '注册赠送', redeem: '兑换码', creation: '剧本生成',
    screenplay_video: '剧本视频', screenplay_image: '剧本图片',
    video_critic_rewrite: '视频评审', video_generation: '视频生成',
  };
  el.innerHTML = creditsHistoryItems.map(t => {
    const sign = t.amount > 0 ? '+' : '';
    const cls = t.amount > 0 ? 'positive' : 'negative';
    const time = t.created_at ? new Date(t.created_at).toLocaleString('zh-CN') : '';
    const label = typeLabels[t.type] || t.type;
    return `<div class="credits-history-row">
      <div><span class="credits-history-time">${esc(time)}</span><span class="credits-history-label">${esc(label)}</span></div>
      <div class="credits-history-amount ${cls}">${sign}${t.amount}<span class="credits-history-balance">余${t.balance_after}</span></div>
    </div>`;
  }).join('');
}

async function generateRedeemCodes() {
  const count = parseInt(document.getElementById('admin-redeem-count')?.value) || 10;
  const credits = parseInt(document.getElementById('admin-redeem-credits')?.value) || 50;
  const statusEl = document.getElementById('admin-redeem-status');
  if (!statusEl) return;
  statusEl.textContent = '生成中...';
  const { response, data } = await apiFetch('/api/admin/redeem-codes/generate', {
    method: 'POST', headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ count, credits }),
  });
  if (response.ok && data?.ok) {
    statusEl.textContent = `已生成 ${data.codes.length} 个兑换码`;
    statusEl.style.color = 'var(--success)';
    loadRedeemCodes();
  } else {
    statusEl.textContent = data?.error || '生成失败';
    statusEl.style.color = 'var(--error)';
  }
}

async function loadRedeemCodes() {
  const { response, data } = await apiFetch('/api/admin/redeem-codes');
  if (!response.ok) return;
  const el = document.getElementById('admin-redeem-list');
  if (!el) return;
  if (!data?.length) {
    el.innerHTML = '<div style="color:var(--text-muted)">暂无兑换码</div>';
    return;
  }
  el.innerHTML = `<table class="admin-credits-table">
    <tr><th>兑换码</th><th>积分</th><th>状态</th><th>使用者</th><th>创建时间</th></tr>
    ${data.map(rc => {
      const status = rc.is_used ? `<span style="color:var(--text-muted)">已使用</span>` : `<span style="color:var(--success,#22c55e)">可用</span>`;
      const time = rc.created_at ? new Date(rc.created_at).toLocaleString('zh-CN') : '';
      return `<tr>
        <td class="code-cell" onclick="copyRedeemCode('${rc.code}', this)" title="点击复制">${rc.code}</td>
        <td>${rc.credits}</td>
        <td>${status}</td>
        <td>${rc.redeemed_by || '-'}</td>
        <td style="color:var(--text-muted)">${time}</td>
      </tr>`;
    }).join('')}
  </table>`;
}

function copyRedeemCode(code, cell) {
  if (!navigator.clipboard?.writeText) return;
  navigator.clipboard.writeText(code).then(() => {
    if (cell) cell.style.color = 'var(--accent)';
  }).catch(() => {});
}

async function loadAdminCreditsOverview() {
  const { response, data } = await apiFetch('/api/admin/credits/overview');
  if (!response.ok) return;
  const el = document.getElementById('admin-credits-overview');
  if (!el) return;
  if (!data?.length) {
    el.innerHTML = '<div style="color:var(--text-muted)">暂无数据</div>';
    return;
  }
  el.innerHTML = `<table class="admin-credits-table">
    <tr><th>用户</th><th>角色</th><th>余额</th><th>总充值</th><th>总消耗</th></tr>
    ${data.map(u => {
      return `<tr>
        <td>${esc(u.username)}</td>
        <td>${u.role === 'admin' ? '管理员' : '用户'}</td>
        <td style="font-weight:600;color:var(--accent)">${u.credits}</td>
        <td class="credits-history-amount positive">+${u.total_added}</td>
        <td class="credits-history-amount negative">-${u.total_spent}</td>
      </tr>`;
    }).join('')}
  </table>`;
}

function resetSessionClientState() {
  try { ws?.close?.(); } catch (_) {}
  ws = null;
  currentUser = null;
  currentCsrfToken = '';
  adminUsers = [];
  currentData = null;
  videoJobsData = [];
  repoData = null;
  projectList = [];
  activeProject = null;
  selectedVideoJobId = null;
  creditsHistoryPage = 1;
  creditsHistoryItems = [];
  closeUserMenu();
  closeRegisterModal();
}

function redirectToLogin() {
  resetSessionClientState();
  updateUserUi();
  openAuthModal('login');
}

async function apiFetch(url, options = {}) {
  const opts = { credentials: 'same-origin', ...options };
  const headers = new Headers(options.headers || {});
  const method = (opts.method || 'GET').toUpperCase();
  if (!['GET', 'HEAD', 'OPTIONS'].includes(method)) {
    const token = getCurrentCsrfToken();
    if (token && !headers.has('x-csrf-token')) headers.set('x-csrf-token', token);
  }
  opts.headers = headers;
  const res = await nativeFetch(url, opts);
  if (res.status === 401) {
    redirectToLogin();
    throw new Error('登录已失效，请重新登录');
  }
  if (res.status === 403) {
    const data = await parseApiJsonSafely(res);
    if (String(data?.error || '').toLowerCase().includes('csrf')) {
      updateCsrfToken();
      throw new Error('安全校验失败，请刷新页面后重试');
    }
    return { response: res, data };
  }
  const data = await parseApiJsonSafely(res);
  return { response: res, data };
}

window.fetch = async (input, init = {}) => {
  const opts = { credentials: 'same-origin', ...(init || {}) };
  const headers = new Headers(opts.headers || {});
  const method = (opts.method || 'GET').toUpperCase();
  if (!['GET', 'HEAD', 'OPTIONS'].includes(method)) {
    const token = getCurrentCsrfToken();
    if (token && !headers.has('x-csrf-token')) headers.set('x-csrf-token', token);
  }
  const res = await nativeFetch(input, { ...opts, headers });
  if (res.status === 401) {
    redirectToLogin();
    throw new Error('登录已失效，请重新登录');
  }
  return res;
}

async function ensureAuthenticated() {
  const { response, data } = await apiFetch('/api/auth/me');
  if (!response.ok || !data?.authenticated || !data.user) {
    currentUser = null;
    updateCsrfToken();
    updateUserUi();
    throw new Error(data?.error || '未登录');
  }
  currentUser = data.user;
  updateCsrfToken();
  updateUserUi();
  return currentUser;
}

function openTutorialModal() {
  document.getElementById('tutorial-modal')?.classList.add('show');
}

function closeTutorialModal() {
  document.getElementById('tutorial-modal')?.classList.remove('show');
}

function openCreditRulesModal() {
  document.getElementById('credit-rules-modal')?.classList.add('show');
}

function closeCreditRulesModal() {
  document.getElementById('credit-rules-modal')?.classList.remove('show');
}

function handleUserEntryClick() {
  if (currentUser) {
    openUserMenu();
    return;
  }
  openAuthModal('login');
}

function openUserMenu() {
  if (!currentUser) {
    openAuthModal('login');
    return;
  }
  document.getElementById('user-menu-modal')?.classList.add('show');
  updateUserUi();
  loadUserCredits();
  if (currentUser?.role === 'admin') {
    loadAdminUsers();
    loadRedeemCodes();
    loadAdminCreditsOverview();
  }
}

function closeUserMenu() {
  document.getElementById('user-menu-modal')?.classList.remove('show');
}

function openAuthModal(mode = 'login') {
  const modal = document.getElementById('auth-modal');
  if (!modal) return;
  setAuthModalMode(mode);
  modal.classList.add('show');
}

function closeAuthModal() {
  document.getElementById('auth-modal')?.classList.remove('show');
}

function setAuthModalMode(mode = 'login') {
  const isRegister = mode === 'register';
  const title = document.getElementById('auth-modal-title');
  const subtitle = document.getElementById('auth-modal-subtitle');
  const loginForm = document.getElementById('auth-login-form');
  const registerPanel = document.getElementById('auth-register-panel');
  const loginStatus = document.getElementById('auth-modal-status');
  const registerStatus = document.getElementById('auth-register-status');
  if (title) title.textContent = isRegister ? '注册账号' : '登录账号';
  if (subtitle) subtitle.textContent = isRegister ? '使用邮箱创建新账户并进入工作台' : '输入已有账号信息，或切换到注册';
  if (loginForm) loginForm.style.display = isRegister ? 'none' : 'flex';
  if (registerPanel) registerPanel.style.display = isRegister ? 'flex' : 'none';
  if (loginStatus) loginStatus.textContent = '';
  if (registerStatus) registerStatus.textContent = isRegister ? '选择下方方式开始注册。' : '';
}

async function logout() {
  try {
    setUserMenuStatus('正在退出登录...');
    const { response, data } = await apiFetch('/api/auth/logout', { method: 'POST' });
    if (!response.ok || !data.ok) throw new Error(data.error || '退出登录失败');
  } catch (_) {
    // ignore and always return to inline auth
  }
  resetSessionClientState();
  updateUserUi();
  openAuthModal('login');
}

function renderAdminUsers() {
  const listEl = document.getElementById('admin-users-list');
  if (!listEl) return;
  if (!adminUsers.length) {
    listEl.innerHTML = `<div class="admin-user-row"><div class="admin-user-main"><div class="admin-user-name">暂无用户</div><div class="admin-user-path">请先创建账号</div></div></div>`;
    return;
  }
  listEl.innerHTML = adminUsers.map(user => {
    const roleLabel = user.role === 'admin' ? '管理员' : '普通用户';
    const statusLabel = user.is_active ? '启用中' : '已禁用';
    const statusClass = user.is_active ? '' : ' inactive';
    const toggleAction = user.is_active ? `disableAdminUser(${user.id})` : `enableAdminUser(${user.id})`;
    const toggleLabel = user.is_active ? '禁用' : '启用';
    const disableDanger = user.is_active ? ' danger-btn' : '';
    return `
      <div class="admin-user-row">
        <div class="admin-user-main">
          <div class="admin-user-name">${esc(user.username)}</div>
          <div class="admin-user-path">积分余额：${user.credits ?? 0}</div>
        </div>
        <div>
          <div class="admin-user-badge${statusClass}">${statusLabel}</div>
        </div>
        <div class="admin-user-role">${roleLabel}${user.uses_legacy_workspace ? ' · 旧工作区' : ''}</div>
        <div class="admin-user-actions">
          ${user.role === 'admin' ? '' : `<button class="${disableDanger}" onclick="${toggleAction}">${toggleLabel}</button>`}
          <button onclick="resetAdminUserPassword(${user.id}, '${String(user.username).replace(/'/g, "\\'")}')">重置密码</button>
        </div>
      </div>
    `;
  }).join('');
}

async function loadAdminUsers() {
  if (currentUser?.role !== 'admin') return;
  setUserMenuStatus('正在加载用户列表...');
  const { response, data } = await apiFetch('/api/admin/users');
  if (!response.ok) {
    setUserMenuStatus(data.error || '加载用户列表失败', 'error');
    return;
  }
  adminUsers = Array.isArray(data) ? data : [];
  renderAdminUsers();
  setUserMenuStatus(`已加载 ${adminUsers.length} 个用户`, 'success');
}

async function createAdminUser() {
  const usernameEl = document.getElementById('admin-create-username');
  const passwordEl = document.getElementById('admin-create-password');
  const roleEl = document.getElementById('admin-create-role');
  const username = usernameEl?.value.trim() || '';
  const password = passwordEl?.value.trim() || '';
  const role = roleEl?.value || 'user';
  if (!username || password.length < 8) {
    setUserMenuStatus('请输入用户名，并设置至少 8 位密码', 'error');
    return;
  }
  setUserMenuStatus('正在创建用户...');
  const { response, data } = await apiFetch('/api/admin/users', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ username, password, role }),
  });
  if (!response.ok || !data.ok) {
    setUserMenuStatus(data.error || '创建用户失败', 'error');
    return;
  }
  usernameEl.value = '';
  passwordEl.value = '';
  roleEl.value = 'user';
  setUserMenuStatus(`用户 ${data.user?.username || username} 已创建`, 'success');
  await loadAdminUsers();
}

async function disableAdminUser(userId) {
  if (!confirm('确认禁用该用户吗？')) return;
  setUserMenuStatus('正在禁用用户...');
  const { response, data } = await apiFetch(`/api/admin/users/${userId}/disable`, { method: 'POST' });
  if (!response.ok || !data.ok) {
    setUserMenuStatus(data.error || '禁用用户失败', 'error');
    return;
  }
  setUserMenuStatus('用户已禁用', 'success');
  await loadAdminUsers();
}

async function enableAdminUser(userId) {
  setUserMenuStatus('正在启用用户...');
  const { response, data } = await apiFetch(`/api/admin/users/${userId}/enable`, { method: 'POST' });
  if (!response.ok || !data.ok) {
    setUserMenuStatus(data.error || '启用用户失败', 'error');
    return;
  }
  setUserMenuStatus('用户已启用', 'success');
  await loadAdminUsers();
}

async function resetAdminUserPassword(userId, username) {
  const password = prompt(`请输入用户 ${username} 的新密码（至少 8 位）`);
  if (password == null) return;
  if (String(password).trim().length < 8) {
    setUserMenuStatus('密码至少需要 8 位', 'error');
    return;
  }
  setUserMenuStatus('正在重置密码...');
  const { response, data } = await apiFetch(`/api/admin/users/${userId}/reset-password`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ password: String(password).trim() }),
  });
  if (!response.ok || !data.ok) {
    setUserMenuStatus(data.error || '重置密码失败', 'error');
    return;
  }
  setUserMenuStatus(`用户 ${username} 的密码已重置`, 'success');
  await loadAdminUsers();
}

function patchBrowseToolbarAndFilmstripFromState(container, st) {
  const toolbar = container.querySelector('.monitor-run-toolbar');
  const scroll = container.querySelector('#browse-filmstrip-scroll');
  if (!toolbar || !scroll) return false;
  const wrap = document.createElement('div');
  wrap.innerHTML = _browseToolbarOuterHTML(st).trim();
  toolbar.replaceWith(wrap.firstElementChild);
  scroll.innerHTML = st.filmstripHTML + st.finalCardHTML;
  window._browseUnitInfos = st.unitInfos;
  window._browseMediaBase = st.mediaBase;
  window._browseSb = st.sb;
  window._browseFinalSrc = st.finalSrc || null;
  document.querySelectorAll('.browse-filmstrip-item:not(.final-card)').forEach((el, i) =>
    el.classList.toggle('active', i === browseSelectedUnit && browseSelectedUnit >= 0)
  );
  document.querySelectorAll('.browse-filmstrip-item.final-card').forEach(el =>
    el.classList.toggle('active', browseSelectedUnit === -1)
  );
  const hdr = container.querySelector('.browse-filmstrip-header span');
  if (hdr) {
    hdr.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="vertical-align:-2px"><polygon points="5,3 19,12 5,21"/></svg> Timeline &middot; ${st.units.length} units`;
  }
  syncConcatModeControls();
  syncMonitorActionButtons();
  return true;
}

function maybeApplyIncrementalBrowseWsRefresh(pane) {
  if (!pane || !currentData) return false;
  let st;
  try {
    st = _computeBrowseRenderState();
  } catch (e) {
    return false;
  }
  const sigs = computeBrowseRefreshSigsFromState(st);
  const prev = _browseLiveSigCache;

  if (prev && sigs.filmSig === prev.filmSig && sigs.finSig === prev.finSig && sigs.tbSig === prev.tbSig && sigs.unitSig === prev.unitSig) {
    return true;
  }

  const onFinal = browseSelectedUnit === -1 && pane.querySelector('#browse-detail-area .final-stage-shell');
  const onUnitDetail = browseSelectedUnit >= 0 && pane.querySelector('#browse-detail-area .browse-detail-shell');

  if (onFinal) {
    if (!prev || sigs.finSig !== prev.finSig) return false;
    patchBrowseToolbarAndFilmstripFromState(pane, st);
    _browseLiveSigCache = sigs;
    return true;
  }

  if (onUnitDetail) {
    const unitChanged = !prev || sigs.unitSig !== prev.unitSig;
    if (unitChanged) {
      window._browseUnitInfos = st.unitInfos;
      window._browseMediaBase = st.mediaBase;
      window._browseSb = st.sb;
      window._browseFinalSrc = st.finalSrc || null;
      browseSelectUnit(browseSelectedUnit);
    }
    if (!prev || sigs.filmSig !== prev.filmSig || sigs.tbSig !== prev.tbSig || sigs.finSig !== prev.finSig) {
      patchBrowseToolbarAndFilmstripFromState(pane, st);
    }
    _browseLiveSigCache = sigs;
    return true;
  }

  return false;
}

function shouldRefreshMonitorBrowseInPlace(pane) {
  if (!pane?.querySelector('.browse-layout')) return false;
  if (monitorBrowseMode) {
    return (
      currentData?.storyboard_name === monitorBrowseMode.project
      && String(currentData?.run_id || '') === String(monitorBrowseMode.run_id || '')
    );
  }
  const job = videoJobsData.find(j => j.job_id === selectedVideoJobId);
  if (!job) return false;
  return (
    currentData?.storyboard_name === job.storyboard_name
    && (!job.run_id || String(currentData?.run_id || '') === String(job.run_id))
  );
}

