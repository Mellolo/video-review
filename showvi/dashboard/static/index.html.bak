    <p><span data-i18n="assets.upload_file_label">已选文件</span>：<span id="asset-upload-file-value">-</span></p>
    <input type="text" id="asset-upload-name-input" data-i18n-placeholder="assets.upload_name_placeholder" placeholder="请输入素材名称" autocomplete="off" spellcheck="false">
