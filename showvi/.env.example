# ═══════════════════════════════════════════════════════════════════════════
# Showvi — Environment Configuration
# Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────
# LLM Provider (必填)
# Options: google | openai_compatible
# ───────────────────────────────────────────────────────────────────────────

# --- Google 官方 API ---
LLM_PROVIDER=google
GEMINI_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-2.5-flash

# --- 或: OpenAI-compatible API ---
# 适用于 DeepSeek, Moonshot, Qwen, OpenRouter, Together AI 等。
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-your-key-here
# LLM_MODEL=deepseek-chat

# --- 或: Custom plugin ---
# Place your client code in clients/custom/<name>.py
# LLM_PROVIDER=custom:my_llm_provider

# ───────────────────────────────────────────────────────────────────────────
# Per-step LLM model overrides (optional)
# Format: LLM_MODEL_<STEP_ID>=<model_name>
# If not set, falls back to LLM_MODEL above.
# ───────────────────────────────────────────────────────────────────────────

# Screenplay generation — use a reasoning model for better story quality
# LLM_MODEL_SCREENPLAY_GEN=deepseek-reasoner

# Storyboard segmentation
# LLM_MODEL_STORYBOARD_GEN=gemini-2.5-flash

# Video analysis (requires video-capable model/provider)
# LLM_PROVIDER_VIDEO_ANALYSIS=google
# LLM_MODEL_VIDEO_ANALYSIS=gemini-2.5-flash

# Image prompt rewriting — a fast cheap model is fine
# LLM_MODEL_PROMPT_REWRITE=deepseek-chat

# Scene rewriting
# LLM_MODEL_SCENE_REWRITE=gemini-2.5-flash

# Scene editing
# LLM_MODEL_SCENE_EDIT=gemini-2.5-flash

# Video critique / quality evaluation (requires video-capable model/provider)
# LLM_PROVIDER_VIDEO_CRITIQUE=google
# LLM_MODEL_VIDEO_CRITIQUE=gemini-2.5-pro

# Video selection (requires video-capable model/provider)
# LLM_PROVIDER_VIDEO_SELECT=google
# LLM_MODEL_VIDEO_SELECT=gemini-2.5-flash

# Style consistency check (image input)
# LLM_MODEL_STYLE_CHECK=gemini-2.5-flash

# Transition bridge generation
# LLM_MODEL_TRANSITION=gemini-2.5-flash

# Screenplay metadata sync
# LLM_MODEL_METADATA_SYNC=gemini-2.5-flash

# ───────────────────────────────────────────────────────────────────────────
# Image Generation Provider (必填)
# Options: google | openai_compatible
# ───────────────────────────────────────────────────────────────────────────

# --- Google 官方图片生成 ---
# 使用上方已配置的 GEMINI_API_KEY，无需额外 key。
IMAGE_PROVIDER=google
IMAGE_MODEL=gemini-2.0-flash-preview-image-generation

# --- 或: OpenAI-compatible (gpt-image-2 / DALL-E 3 / Flux 等) ---
# IMAGE_PROVIDER=openai_compatible
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_API_KEY=sk-your-key-here
# IMAGE_MODEL=gpt-image-2

# ───────────────────────────────────────────────────────────────────────────
# Video Generation — 即梦 Seedance 2.0 (必填)
# ───────────────────────────────────────────────────────────────────────────

# 从即梦网站 Cookie 获取 session_id（见 README 说明）
SEEDDANCE_SESSION_ID=your-session-id
SEEDDANCE_BACKEND=jimeng

# ───────────────────────────────────────────────────────────────────────────
# 以下为可选配置
# ───────────────────────────────────────────────────────────────────────────

# Output directory
# OUTPUT_DIR=./output
